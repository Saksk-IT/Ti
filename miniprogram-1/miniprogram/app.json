  "usingComponents": {
    "nav-left-buttons": "components/nav-left-buttons/nav-left-buttons",
    "skeleton-screen": "components/skeleton-screen/skeleton-screen",
    "empty-state": "components/empty-state/empty-state"
  },
  "window": {
    "navigationStyle": "custom",
    "backgroundColor": "@backgroundColor",
    "backgroundTextStyle": "@backgroundTextStyle",
    "navigationBarBackgroundColor": "@navigationBarBackgroundColor",
    "navigationBarTextStyle": "@navigationBarTextStyle"
  },
  "tabBar": {
    "color": "@tabBarColor",
    "selectedColor": "@tabBarSelectedColor",
    "borderStyle": "@tabBarBorderStyle",
    "backgroundColor": "@tabBarBackgroundColor",
    "list": [
      {
        "pagePath": "pages/hub-v2/hub-v2",
        "iconPath": "images/tabbar/home.png",
        "selectedIconPath": "images/tabbar/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/subjects/subjects",
        "iconPath": "images/tabbar/subject.png",
        "selectedIconPath": "images/tabbar/subject-active.png",
        "text": "科目"
      },
      {
        "pagePath": "pages/my-banks-v2/my-banks-v2",
        "iconPath": "images/tabbar/practice.png",
        "selectedIconPath": "images/tabbar/practice-active.png",
        "text": "题库"
      },
      {
        "pagePath": "pages/mine/mine",
        "iconPath": "images/tabbar/mine.png",
        "selectedIconPath": "images/tabbar/mine-active.png",
        "text": "我的"
      }
    ]
  },
  "preloadRule": {
    "pages/hub-v2/hub-v2": {
      "network": "all",
      "packages": [
        "pages/index-v2",
        "pages/subject-detail-v2",
        "pages/bank-detail"
      ]
    }
  },
  "style": "v2",
  "darkmode": true,
  "themeLocation": "theme.json",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
