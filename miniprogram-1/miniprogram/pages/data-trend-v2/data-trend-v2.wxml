<view class="page-root {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="趋势" back="{{false}}" color="var(--app-nav-fg)" background="var(--app-nav-bg)">
    <view slot="left" class="nav-left">
      <view class="icon-btn" bindtap="onHamburgerTap" aria-role="button" aria-label="打开侧边栏">
        <view class="icon-hamburger"></view>
      </view>
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <v2-drawer
    open="{{drawerOpen}}"
    themeStyle="{{themeStyle}}"
    activeKey="history"
    bind:close="onDrawerClose"
    bind:navigate="onDrawerNavigate"
    bind:selectstyle="onDrawerSelectStyle"
  />

  <view class="page-container">
    <scroll-view
      class="content-area"
      scroll-y
      bounces="{{false}}"
      refresher-enabled="{{true}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <view class="container">
        <view class="card hero" aria-label="趋势">
          <view class="hero-head">
            <view class="hero-left">
              <text class="hero-title">学习趋势</text>
              <text class="hero-sub">把节奏做稳，才能把正确率做稳。</text>
              <text class="hero-sub">窗口已做 {{windowAnswered}} · 正确率 {{windowAccuracy}}%</text>
            </view>
            <view class="hero-right">
              <view class="days-tabs" aria-label="趋势窗口">
                <view class="days-tab {{days===7 ? 'active' : ''}}" bindtap="onDaysTap" data-days="7"><text>7天</text></view>
                <view class="days-tab {{days===30 ? 'active' : ''}}" bindtap="onDaysTap" data-days="30"><text>30天</text></view>
                <view class="days-tab {{days===90 ? 'active' : ''}}" bindtap="onDaysTap" data-days="90"><text>90天</text></view>
              </view>
            </view>
          </view>
          <view class="data-tabs" aria-label="数据中心导航">
            <view class="data-tab" bindtap="onTabTap" data-tab="overview"><text>概览</text></view>
            <view class="data-tab" bindtap="onTabTap" data-tab="banks"><text>题库</text></view>
            <view class="data-tab active"><text>趋势</text></view>
            <view class="data-tab" bindtap="onTabTap" data-tab="ai"><text>AI助手</text></view>
          </view>
        </view>

        <view class="card section-card" aria-label="趋势图谱">
          <text class="section-title">趋势图谱</text>
          <text class="section-sub">近{{days}}天：日趋势 × 小时分布 × 周内节奏。</text>

          <view class="chart-grid">
            <view class="chart-card">
              <text class="chart-title">日趋势</text>
              <text class="chart-sub">公共 + 个人合并</text>
              <view class="chart-visual">
                <scroll-view class="trend-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                  <view class="trend-bars">
                    <view
                      class="trend-bar"
                      wx:for="{{trendBars}}"
                      wx:for-item="bar"
                      wx:key="day"
                      style="height: {{bar.barPct}}%;"
                      bindtap="onDayBarTap"
                      data-day="{{bar.day}}"
                      data-total="{{bar.total}}"
                      data-accuracy="{{bar.accuracy}}"
                    >
                      <view class="trend-fill" style="height: {{bar.fillPct}}%;"></view>
                    </view>
                  </view>
                </scroll-view>
              </view>
            </view>

            <view class="chart-card">
              <text class="chart-title">按小时分布</text>
              <text class="chart-sub">高频时段建议固定</text>
              <view class="chart-visual">
                <view class="trend-bars" style="height: 140rpx;">
                  <view
                    class="trend-bar"
                    wx:for="{{hourlyBars}}"
                    wx:for-item="bar"
                    wx:key="hour"
                    style="height: {{bar.barPct}}%;"
                  >
                    <view class="trend-fill" style="height: 100%;"></view>
                  </view>
                </view>
              </view>
            </view>

            <view class="chart-card">
              <text class="chart-title">周内分布</text>
              <text class="chart-sub">周节奏决定稳定性</text>
              <view class="chart-visual">
                <view class="rank-list">
                  <view class="rank-item" wx:for="{{weekdayBars}}" wx:for-item="d" wx:key="name">
                    <text class="rank-name">{{d.name}}</text>
                    <text class="rank-meta">已做 {{d.total}}</text>
                    <view class="rank-bar"><view class="rank-fill" style="width: {{d.barPct}}%;"></view></view>
                  </view>
                </view>
              </view>
            </view>

            <view class="chart-card">
              <text class="chart-title">活跃热力图</text>
              <text class="chart-sub">周 × 小时</text>
              <view class="chart-visual">
                <view class="heatmap-grid">
                  <view class="heatmap-row" wx:for="{{heatmapRows}}" wx:for-item="row" wx:key="dayIndex">
                    <view
                      class="heat-cell heat-lv{{cell.level}}"
                      wx:for="{{row.cells}}"
                      wx:for-item="cell"
                      wx:key="index"
                    ></view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="card section-card" aria-label="题型与难度">
          <text class="section-title">题型与难度</text>
          <text class="section-sub">从题型与难度拆解效率。</text>

          <view class="chart-grid">
            <view class="chart-card">
              <text class="chart-title">按题型</text>
              <view class="chart-visual">
                <view class="rank-list">
                  <view class="rank-item" wx:for="{{typeRows}}" wx:for-item="t" wx:key="q_type">
                    <text class="rank-name">{{t.q_type}}</text>
                    <text class="rank-meta">已做 {{t.answered}} · 正确率 {{t.accuracy}}%</text>
                    <view class="rank-bar"><view class="rank-fill" style="width: {{t.accuracy}}%;"></view></view>
                  </view>
                </view>
              </view>
            </view>

            <view class="chart-card">
              <text class="chart-title">按难度</text>
              <view class="chart-visual">
                <view class="rank-list">
                  <view class="rank-item" wx:for="{{difficultyRows}}" wx:for-item="d" wx:key="difficulty">
                    <text class="rank-name">{{d.label}}</text>
                    <text class="rank-meta">已做 {{d.answered}} · 正确率 {{d.accuracy}}%</text>
                    <view class="rank-bar"><view class="rank-fill" style="width: {{d.accuracy}}%;"></view></view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="msg error" wx:if="{{errorMsg}}">
          <text>{{errorMsg}}</text>
        </view>
        <view class="loading" wx:if="{{loading}}">
          <text>正在加载数据...</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
