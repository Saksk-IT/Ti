<!-- review-hub-v3.wxml - 复盘总览（全局） -->
<view class="page-root {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="复盘" back="{{false}}" color="var(--app-nav-fg)" background="var(--app-nav-bg)">
    <view slot="left" class="nav-left">
      <view class="icon-btn" bindtap="onHamburgerTap" aria-role="button" aria-label="打开侧边栏">
        <view class="icon-hamburger"></view>
      </view>
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <v2-drawer
    open="{{drawerOpen}}"
    themeStyle="{{themeStyle}}"
    activeKey="review"
    bind:close="onDrawerClose"
    bind:navigate="onDrawerNavigate"
    bind:selectstyle="onDrawerSelectStyle"
  />

  <view class="page-container">
    <scroll-view
      class="content-area"
      scroll-y
      bounces="{{false}}"
      refresher-enabled="{{true}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <view class="container">
        <view class="card hero" aria-label="复盘总览">
          <view class="hero-head">
            <view class="hero-left">
              <text class="hero-title">复盘总览</text>
              <text class="hero-sub">继续上次复盘，或选择范围进入复盘空间（默认错题，可在中心切换收藏/标签）。</text>
            </view>
            <view class="hero-pills">
              <view class="pill" aria-label="公共题库数量">
                <text class="k">公共</text>
                <text class="v">{{publicTotal}}</text>
              </view>
              <view class="pill" aria-label="个人题库数量">
                <text class="k">个人</text>
                <text class="v">{{bankTotal}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="card quick-actions" aria-label="快速开始">
          <view class="qa-item">
            <view class="qa-main">
              <text class="qa-title">继续上次复盘</text>
              <text class="qa-sub">{{hasLastSession ? lastSessionSummary : '开始一次复盘后，这里会出现快捷入口。'}}</text>
            </view>
            <view class="qa-actions">
              <view class="mini-btn primary" wx:if="{{hasLastSession}}" catchtap="onContinueLast"><text>进入</text></view>
              <view class="mini-btn" wx:if="{{hasLastSession}}" catchtap="onContinueLastQuick" data-mode="quiz"><text>刷题</text></view>
              <view class="mini-btn" wx:if="{{hasLastSession}}" catchtap="onContinueLastQuick" data-mode="memo"><text>背题</text></view>
            </view>
          </view>
          <view class="divider"></view>
          <view class="qa-item">
            <view class="qa-main">
              <text class="qa-title">今日重点</text>
              <text class="qa-sub">错题（纠错优先）</text>
            </view>
            <view class="qa-actions">
              <view class="mini-btn primary" catchtap="onTodayFocus"><text>去复盘</text></view>
            </view>
          </view>
        </view>

        <view class="basebar" role="tablist" aria-label="题库来源">
          <view class="tabs">
            <view class="tab {{tab==='public' ? 'active' : ''}}" bindtap="onTabTap" data-tab="public">
              <text>公共题库</text>
            </view>
            <view class="tab {{tab==='bank' ? 'active' : ''}}" bindtap="onTabTap" data-tab="bank">
              <text>个人题库</text>
            </view>
          </view>
        </view>

        <view class="card pb-toolbar" aria-label="搜索题库">
          <view class="pb-toolbar-left">
            <view class="search-wrap">
              <text class="search-icon">⌕</text>
              <input
                class="search-input"
                type="text"
                placeholder="{{tab==='public' ? '搜索公共题库' : '搜索个人题库'}}"
                value="{{keyword}}"
                bindinput="onKeywordInput"
                confirm-type="search"
              />
              <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword" aria-role="button" aria-label="清空搜索">
                <text>×</text>
              </view>
            </view>
          </view>
          <view class="pb-toolbar-right">
            <view class="pill"><text>显示 {{shownTotal}} / {{currentTotal}}</text></view>
          </view>
        </view>

        <view wx:if="{{tab === 'public'}}">
          <view class="pb-grid" wx:if="{{filteredSubjects.length}}">
            <view class="pb-card" wx:for="{{filteredSubjects}}" wx:key="id" bindtap="onPublicBankTap" data-id="{{item.id}}" data-name="{{item.name}}">
              <view class="pb-card-top">
                <text class="pb-card-title">{{item.name}}</text>
                <view class="pb-card-arrow"><text>›</text></view>
              </view>
              <view class="pb-card-meta">
                <text>{{item.question_count}} 题</text>
                <text class="pb-dot">·</text>
                <text>进入复盘</text>
              </view>
            </view>
          </view>
          <view class="pb-empty" wx:else>
            <text>{{keyword ? '没有匹配的题库。' : '暂无可用公共题库。'}}</text>
          </view>
        </view>

        <view wx:else>
          <view class="pb-grid" wx:if="{{filteredBanks.length}}">
            <view class="pb-card" wx:for="{{filteredBanks}}" wx:key="id" bindtap="onBankTap" data-id="{{item.id}}">
              <view class="pb-card-top">
                <text class="pb-card-title">{{item.name}}</text>
                <view class="pb-card-arrow"><text>›</text></view>
              </view>
              <view class="pb-card-meta">
                <text>{{item.question_count}} 题</text>
                <text class="pb-dot">·</text>
                <text>进入复盘</text>
              </view>
            </view>
          </view>
          <view class="pb-empty" wx:else>
            <text>{{keyword ? '没有匹配的题库。' : '暂无可用个人题库。'}}</text>
          </view>
        </view>

        <view class="loading" wx:if="{{loading}}">
          <text>加载中...</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

