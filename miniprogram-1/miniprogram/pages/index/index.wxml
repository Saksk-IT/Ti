<!--index.wxml-->
<view class="page-root {{themeClass}} {{themeStyleClass}} {{fontStyleClass}} {{pageVisible ? 'page-visible' : ''}}">
  <navigation-bar title="首页" back="{{false}}" color="var(--app-nav-fg)" background="var(--app-nav-bg)">
    <view slot="left" class="nav-actions">
      <view class="theme-toggle" bindtap="onToggleThemeTap" aria-role="button" aria-label="切换主题">
        <image class="theme-icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>
  <view class="page-container">
    <scroll-view
      class="content-area"
      scroll-y
      type="list"
      bounces="{{false}}"
      refresher-enabled="{{true}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <view class="container">
        <!-- 顶部信息（Glass Card） -->
        <view class="hero-card animate-fade-in">
          <view class="hero-left">
            <image
              class="avatar"
              src="{{(userInfo && (userInfo.avatar || userInfo.avatar_url)) || '/images/default-avatar.png'}}"
              mode="aspectFill"
            ></image>
            <view class="hero-text">
              <text class="hero-title">{{isLoggedIn ? ((userInfo && (userInfo.username || userInfo.nickname)) || '用户') : '未登录'}}</text>
              <text class="hero-subtitle">{{isLoggedIn ? '保持节奏，稳步提升' : '登录后解锁更多功能'}}</text>
            </view>
          </view>
          <view class="hero-right" wx:if="{{isLoggedIn}}" bindtap="onGoSubjectsTap">
            <text class="hero-right-text">科目</text>
          </view>
          <view class="hero-right" wx:else bindtap="onGoLoginTap">
            <text class="hero-right-text">登录</text>
          </view>
        </view>

        <!-- 继续上次练习 -->
        <view class="continue-card animate-slide-up" wx:if="{{lastSession}}" style="animation-delay: 0.1s">
          <view class="card-head">
            <text class="card-title">继续上次</text>
            <text class="card-time">{{lastSession.timeText}}</text>
          </view>
          <view class="card-body">
            <text class="session-subject">{{lastSession.displayName || lastSession.subject || '上次练习'}}</text>
            <text class="session-meta">{{lastSession.metaText}}</text>
          </view>
          <view class="card-actions">
            <view class="primary-btn" bindtap="onContinueTap">
              <text>继续练习</text>
            </view>
          </view>
        </view>

        <!-- 无上次练习记录时：引导开始练习 -->
        <view class="continue-card animate-slide-up" wx:elif="{{!loading && isLoggedIn}}" style="animation-delay: 0.1s">
          <view class="card-head">
            <text class="card-title">开始练习</text>
          </view>
          <view class="card-body">
            <text class="session-subject">从题库广场开始</text>
            <text class="session-meta">选择科目 → 设置练习 → 进入刷题</text>
          </view>
          <view class="card-actions">
            <view class="primary-btn" bindtap="onGoSubjectsTap">
              <text>进入题库广场</text>
            </view>
          </view>
        </view>

        <!-- Bento 数据卡片 -->
        <view class="bento-grid animate-slide-up" style="animation-delay: 0.15s">
          <view class="bento-card">
            <text class="bento-value">{{stats.total || 0}}</text>
            <text class="bento-label">题目</text>
          </view>
          <view class="bento-card">
            <text class="bento-value">{{stats.favorites || 0}}</text>
            <text class="bento-label">收藏</text>
          </view>
          <view class="bento-card">
            <text class="bento-value">{{stats.mistakes || 0}}</text>
            <text class="bento-label">错题</text>
          </view>
          <view class="bento-card bento-action" bindtap="onGoSubjectsTap">
            <text class="bento-action-title">选择科目</text>
            <text class="bento-action-sub">进入科目详情</text>
          </view>
        </view>

        <!-- 加载提示 -->
        <view class="loading animate-fade-in" wx:if="{{loading}}" style="animation-delay: 0.2s">
          <text>加载中...</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
