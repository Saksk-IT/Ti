<!-- campus.wxml - 校园 -->
<view class="page-root campus-page {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <view class="campus-bg"></view>
  <navigation-bar title="校园" back="{{false}}" compact="{{true}}" color="var(--app-nav-fg)" background="transparent">
    <view slot="right" class="nav-right">
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <view class="page-container">
    <scroll-view class="content-area" scroll-y bounces="{{false}}" refresher-enabled="{{true}}" bindrefresherrefresh="onRefresh">
      <view class="container">
        <view class="campus-hero">
          <view class="hero-main">
            <view class="hero-icon-wrap">
              <image class="hero-icon" src="/images/icons/campus.svg" mode="aspectFit"></image>
            </view>
            <view class="hero-copy">
              <text class="hero-title">校园</text>
              <text class="hero-status">{{statusMsg || '教务系统账号状态同步中'}}</text>
              <view class="hero-meta-row">
                <view class="hero-pill {{eduBound ? 'ok' : 'warn'}}">
                  <text>{{eduBound ? '已绑定' : '待绑定'}}</text>
                </view>
                <view class="hero-pill">
                  <text>{{mode === 'grades' ? '成绩查询' : '课表查询'}}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="hero-action {{statusFailed || !eduBound ? 'warn' : ''}}" bindtap="onHeroActionTap" aria-role="button" aria-label="教务系统账号操作">
            <image class="hero-action-icon" src="{{statusFailed ? '/images/icons/refresh-cw.svg' : '/images/icons/settings.svg'}}" mode="aspectFit"></image>
            <text>{{statusFailed ? '重试' : (eduBound ? '更换绑定' : '去绑定')}}</text>
          </view>
          <view class="hero-glow"></view>
        </view>

        <view class="mode-switch" aria-label="校园查询类型">
          <view class="mode-option {{mode === 'schedule' ? 'active' : ''}}" data-mode="schedule" bindtap="onModeTap">
            <view class="mode-icon-wrap">
              <image class="mode-icon" src="/images/icons/book-open.svg" mode="aspectFit"></image>
            </view>
            <view class="mode-copy">
              <text class="mode-title">查询课表</text>
              <text class="mode-sub">课程安排</text>
            </view>
          </view>
          <view class="mode-option {{mode === 'grades' ? 'active' : ''}}" data-mode="grades" bindtap="onModeTap">
            <view class="mode-icon-wrap">
              <image class="mode-icon" src="/images/icons/chart.svg" mode="aspectFit"></image>
            </view>
            <view class="mode-copy">
              <text class="mode-title">查询成绩</text>
              <text class="mode-sub">学分绩点</text>
            </view>
          </view>
        </view>

        <view class="filter-panel" wx:if="{{mode === 'schedule'}}">
          <view class="panel-header">
            <view class="panel-title-wrap">
              <image class="panel-icon" src="/images/icons/sliders.svg" mode="aspectFit"></image>
              <text class="panel-title">查询范围</text>
            </view>
            <text class="panel-note">最多 12 个学期</text>
          </view>
          <view class="year-row">
            <view class="selector-group">
              <view class="selector-head">
                <text class="field-label">学年</text>
                <text class="selector-current">{{academicYearLabels[academicYearIndex]}}</text>
              </view>
              <scroll-view class="term-selector-scroll year-selector-scroll" scroll-x show-scrollbar="{{false}}" enhanced="{{true}}">
                <view class="selector-chip-row">
                  <view
                    class="selector-chip year-chip {{academicYearIndex === index ? 'active' : ''}}"
                    wx:for="{{academicYearLabels}}"
                    wx:key="*this"
                    data-index="{{index}}"
                    bindtap="onAcademicYearTap"
                    aria-role="button"
                    aria-label="选择{{item}}"
                  >
                    <text>{{item}}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
            <view class="selector-group">
              <view class="selector-head">
                <text class="field-label">学期</text>
                <text class="selector-current">{{semesterLabels[semesterIndex]}}</text>
              </view>
              <scroll-view class="term-selector-scroll semester-selector-scroll" scroll-x show-scrollbar="{{false}}" enhanced="{{true}}">
                <view class="selector-chip-row">
                  <view
                    class="selector-chip semester-chip {{semesterIndex === index ? 'active' : ''}}"
                    wx:for="{{semesterLabels}}"
                    wx:key="*this"
                    data-index="{{index}}"
                    bindtap="onSemesterTap"
                    aria-role="button"
                    aria-label="选择{{item}}"
                  >
                    <text>{{item}}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
          </view>
          <view class="query-btn {{loading ? 'disabled' : ''}}" bindtap="onQueryTap" aria-role="button" aria-label="查询校园信息">
            <image class="query-icon" src="{{mode === 'grades' ? '/images/icons/chart.svg' : '/images/icons/book-open.svg'}}" mode="aspectFit"></image>
            <text>{{loading ? '提交中...' : '查询课表'}}</text>
          </view>
        </view>

        <view class="grade-query-panel" wx:elif="{{mode === 'grades'}}">
          <view class="query-btn grade-query-btn {{loading ? 'disabled' : ''}}" bindtap="onQueryTap" aria-role="button" aria-label="查询成绩">
            <image class="query-icon" src="/images/icons/chart.svg" mode="aspectFit"></image>
            <text>{{loading ? '提交中...' : '查询成绩'}}</text>
          </view>
        </view>

        <view class="campus-query-progress" wx:if="{{queryProgressVisible}}">
          <view class="progress-head">
            <view class="progress-title-wrap">
              <image class="progress-icon" src="/images/icons/refresh-cw.svg" mode="aspectFit"></image>
              <text class="progress-title">查询进度</text>
            </view>
            <text class="progress-status">{{queryProgressStatus}}</text>
          </view>
          <view class="query-progress-track">
            <view class="query-progress-fill" style="width: {{queryProgressPercent}}%;"></view>
          </view>
          <text class="progress-detail">{{queryProgressDetail}}</text>
          <text class="progress-meta" wx:if="{{queryProgressMeta}}">{{queryProgressMeta}}</text>
        </view>

        <view class="msg error" wx:if="{{errorMsg}}">
          <text>{{errorMsg}}</text>
        </view>

        <view class="bind-prompt" wx:if="{{statusReady && !statusFailed && !eduBound && !statusLoading}}">
          <view class="prompt-head">
            <view class="prompt-icon-wrap">
              <image class="prompt-icon" src="/images/icons/settings.svg" mode="aspectFit"></image>
            </view>
            <view class="prompt-copy">
              <text class="prompt-title">未绑定教务系统账号</text>
              <text class="prompt-sub">绑定后可在此查询课表和成绩。</text>
            </view>
          </view>
          <view class="prompt-action" bindtap="onGoEduBindingTap" aria-role="button" aria-label="去绑定教务系统账号">
            <image class="prompt-action-icon" src="/images/icons/settings.svg" mode="aspectFit"></image>
            <text>去绑定</text>
          </view>
        </view>

        <view class="snapshot-browser" wx:if="{{snapshotYears.length}}">
          <view class="snapshot-selector-group" aria-label="历史学年筛选">
            <view class="selector-head">
              <text class="field-label">学年</text>
              <text class="selector-current">{{snapshotYearLabels[snapshotYearIndex]}}</text>
            </view>
            <scroll-view class="snapshot-selector-scroll snapshot-year-list" scroll-x show-scrollbar="{{false}}" enhanced="{{true}}">
              <view class="snapshot-chip-row">
                <view
                  class="snapshot-chip snapshot-year-chip {{item.active ? 'active' : ''}}"
                  wx:for="{{snapshotYears}}"
                  wx:key="value"
                  data-value="{{item.value}}"
                  bindtap="onSnapshotYearTap"
                  aria-role="button"
                  aria-label="选择{{item.label}}"
                >
                  <text>{{item.label}}</text>
                  <text class="chip-count">{{item.count}}</text>
                </view>
              </view>
            </scroll-view>
          </view>
          <view class="snapshot-selector-group" aria-label="历史学期筛选">
            <view class="selector-head">
              <text class="field-label">学期</text>
              <text class="selector-current">{{snapshotSemesterLabels[snapshotSemesterIndex]}}</text>
            </view>
            <scroll-view class="snapshot-selector-scroll snapshot-term-list" scroll-x show-scrollbar="{{false}}" enhanced="{{true}}">
              <view class="snapshot-chip-row">
                <view
                  class="snapshot-chip snapshot-term-chip {{item.active ? 'active' : ''}}"
                  wx:for="{{snapshotTerms}}"
                  wx:key="value"
                  data-value="{{item.value}}"
                  bindtap="onSnapshotTermTap"
                  aria-role="button"
                  aria-label="选择{{item.label}}"
                >
                  <text>{{item.label}}</text>
                  <text class="chip-count">{{item.count}}</text>
                </view>
              </view>
            </scroll-view>
          </view>
        </view>

        <block wx:if="{{mode === 'schedule'}}">
          <view class="term-list" wx:if="{{scheduleResults.length}}">
            <view class="term-card" wx:for="{{scheduleResults}}" wx:key="title">
              <view class="term-head">
                <text class="term-title">{{item.title}}</text>
                <text class="term-meta" wx:if="{{item.studentText}}">{{item.studentText}}</text>
              </view>
              <view class="day-block" wx:for="{{item.weekRows}}" wx:for-item="dayRow" wx:key="day">
                <text class="day-title">{{dayRow.day}}</text>
                <view class="section-row" wx:for="{{dayRow.sections}}" wx:for-item="sectionRow" wx:key="section">
                  <text class="section-label">{{sectionRow.section}}</text>
                  <view class="course-list">
                    <view class="course-chip" wx:for="{{sectionRow.courses}}" wx:for-item="course" wx:key="course_name">
                      <text class="course-name">{{course.course_name}}</text>
                      <text class="course-detail">{{course.teacher || '-'}} / {{course.location || '-'}} / {{course.weeks || '-'}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="practice-block" wx:if="{{item.practice_courses.length}}">
                <text class="practice-title">集中实践</text>
                <view class="course-chip" wx:for="{{item.practice_courses}}" wx:for-item="course" wx:key="course_name">
                  <text class="course-name">{{course.course_name}}</text>
                  <text class="course-detail">{{course.teacher || '-'}} / {{course.weeks || '-'}}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="empty-state" wx:elif="{{eduBound && !loading}}">
            <text>暂无课表记录。</text>
          </view>
        </block>

        <block wx:else>
          <view class="term-list" wx:if="{{gradeResults.length}}">
            <view class="term-card" wx:for="{{gradeResults}}" wx:key="title">
              <view class="term-head">
                <text class="term-title">{{item.title}}</text>
                <text class="term-meta">{{item.summaryText}}</text>
              </view>
              <view class="grade-row" wx:for="{{item.grades}}" wx:for-item="grade" wx:key="course_name">
                <view class="grade-main">
                  <text class="course-name">{{grade.course_name}}</text>
                  <text class="course-detail">{{grade.teacher || grade.assessment || '-'}}</text>
                </view>
                <view class="grade-score">
                  <text class="score">{{grade.score}}</text>
                  <text class="score-sub">{{grade.credits}} 学分 / 绩点 {{grade.grade_point}}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="empty-state" wx:elif="{{eduBound && !loading}}">
            <text>暂无成绩记录。</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="campus-captcha-dialog" wx:if="{{captchaVisible}}">
    <view class="captcha-mask" bindtap="onCaptchaCancelTap"></view>
    <view class="captcha-panel">
      <view class="captcha-head">
        <text class="captcha-title">输入 WebVPN 验证码</text>
        <text class="captcha-sub">{{captchaMode === 'grades' ? '成绩查询需要刷新登录态' : '课表查询需要刷新登录态'}}</text>
      </view>
      <text class="captcha-message">{{captchaMessage}}</text>
      <image class="captcha-image" wx:if="{{captchaImage}}" src="{{captchaImage}}" mode="aspectFit"></image>
      <input class="captcha-input" value="{{captchaCode}}" maxlength="10" placeholder="请输入验证码" bindinput="onCaptchaInput" />
      <view class="captcha-actions">
        <view class="captcha-action ghost" bindtap="onCaptchaCancelTap" aria-role="button" aria-label="取消验证码输入">取消</view>
        <view class="captcha-action primary {{captchaSubmitting ? 'disabled' : ''}}" bindtap="onCaptchaSubmitTap" aria-role="button" aria-label="提交验证码">
          {{captchaSubmitting ? '提交中...' : '继续查询'}}
        </view>
      </view>
    </view>
  </view>
</view>
