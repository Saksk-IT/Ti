<!--settings-practice-v2.wxml - -->
<view class="page-root mine-linked-page {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="通用设置" back="{{true}}" compact="{{true}}" color="var(--app-nav-fg)" background="transparent">
    <view slot="right" class="nav-right">
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <view class="page-container">
    <scroll-view class="content-area" scroll-y bounces="{{false}}">
      <view class="container">
        <view class="card hero" aria-label="通用设置概览">
          <text class="hero-title">通用</text>
          <text class="hero-sub">通用设置与基础操作。</text>
        </view>

        <view class="msg" wx:if="{{msg}}">
          <text>{{msg}}</text>
        </view>

        <view class="card section-card" aria-label="首页科目显示">
          <text class="section-title">首页科目</text>
          <text class="section-sub">控制首页题库/练习入口显示哪些科目。</text>
          <view class="divider"></view>
          <view class="row">
            <view class="row-main">
              <text class="row-title">显示范围</text>
              <text class="row-sub">{{subjectsLoading ? '加载科目中…' : subjectSummary}}</text>
            </view>
            <view class="btn btn-quiet" bindtap="onOpenSubjectModal" aria-role="button" aria-label="选择首页科目">
              <text>选择</text>
            </view>
          </view>
          <view class="divider divider-tight"></view>
          <view class="row">
            <view class="row-main">
              <text class="row-title">全部科目</text>
              <text class="row-sub">清除筛选后，首页会显示全部科目。</text>
            </view>
            <view class="btn" bindtap="onClearSubjectFilter" aria-role="button" aria-label="显示全部科目">
              <text>显示全部</text>
            </view>
          </view>
        </view>

        <view class="card section-card" aria-label="刷题入口">
          <text class="section-title">刷题入口</text>
          <text class="section-sub">仅影响小程序端刷题操作体验。</text>
          <view class="divider"></view>
          <view class="row">
            <view class="row-main">
              <text class="row-title">刷题悬浮球</text>
              <text class="row-sub">在练习页展示快速操作入口。</text>
            </view>
            <switch checked="{{quizFabEnabled}}" bindchange="onQuizFabChange" />
          </view>
        </view>

        <view class="card section-card" aria-label="刷题布局">
          <text class="section-title">刷题布局</text>
          <text class="section-sub">选择练习页题目展示方式。</text>
          <view class="layout-grid">
            <view class="layout-card {{quizLayoutTheme==='traditional' ? 'active' : ''}}" bindtap="onLayoutTap" data-layout="traditional">
              <text class="layout-title">传统布局</text>
              <text class="layout-sub">信息密度更高，适合连续刷题。</text>
            </view>
            <view class="layout-card {{quizLayoutTheme==='card' ? 'active' : ''}}" bindtap="onLayoutTap" data-layout="card">
              <text class="layout-title">卡片布局</text>
              <text class="layout-sub">留白更多，适合逐题阅读。</text>
            </view>
          </view>
        </view>

        <view class="card section-card" aria-label="恢复默认">
          <text class="section-title">默认值</text>
          <text class="section-sub">恢复科目显示、悬浮球和刷题布局默认配置。</text>
          <view class="divider"></view>
          <view class="btn btn-danger" bindtap="onResetPractice" aria-role="button" aria-label="恢复通用设置默认值">
            <text>恢复默认</text>
          </view>
        </view>

        <view class="modal-overlay" wx:if="{{subjectModalOpen}}" bindtap="onCloseSubjectModal">
          <view class="modal" catchtap="stopTap">
            <view class="modal-head">
              <view class="modal-head-left">
                <text class="modal-title">选择首页科目</text>
                <text class="modal-sub">{{subjectsLoading ? '加载中…' : '已加载 ' + modalRows.length + ' 门科目'}}</text>
              </view>
              <view class="modal-close" bindtap="onCloseSubjectModal" aria-role="button" aria-label="关闭">
                <text>×</text>
              </view>
            </view>

            <view class="modal-ops">
              <view class="btn btn-quiet" bindtap="onSelectAllSubjects"><text>全选</text></view>
              <view class="btn" bindtap="onClearAllSubjects"><text>清空</text></view>
            </view>

            <scroll-view class="modal-list" scroll-y>
              <view class="empty-line" wx:if="{{!subjectsLoading && !modalRows.length}}">
                <text>暂无可用科目</text>
              </view>
              <checkbox-group bindchange="onModalSubjectChange">
                <label class="subject-row" wx:for="{{modalRows}}" wx:key="name">
                  <view class="subject-copy">
                    <text class="subject-name">{{item.name}}</text>
                  </view>
                  <checkbox value="{{item.name}}" checked="{{item.checked}}" />
                </label>
              </checkbox-group>
            </scroll-view>

            <view class="modal-actions">
              <view class="btn" bindtap="onCancelSubjectSelection"><text>取消</text></view>
              <view class="btn btn-primary" bindtap="onApplySubjectSelection"><text>应用</text></view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
