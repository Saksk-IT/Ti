<!--settings-practice-v2.wxml - -->
<view class="page-root mine-linked-page {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="通用设置" back="{{true}}" compact="{{true}}" color="var(--app-nav-fg)" background="transparent">
    <view slot="right" class="nav-right">
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <view class="page-container">
    <scroll-view class="content-area" scroll-y bounces="{{false}}">
      <view class="container">
        <view class="card hero" aria-label="通用设置概览">
          <text class="hero-title">通用</text>
          <text class="hero-sub">通用设置与基础操作。</text>
        </view>

        <view class="card nav-card" aria-label="设置分区导航">
          <view class="tabs">
            <view class="tab {{navKey==='account' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="account"><text>账号管理</text></view>
            <view class="tab {{navKey==='practice' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="practice"><text>通用</text></view>
            <view class="tab {{navKey==='theme' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="theme"><text>主题</text></view>
            <view class="tab {{navKey==='about' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="about"><text>关于</text></view>
          </view>
        </view>

        <view class="msg" wx:if="{{msg}}">
          <text>{{msg}}</text>
        </view>

        <view class="card section-card" aria-label="待开发">
          <text class="section-title">待开发</text>
          <text class="section-sub">该页面功能正在完善中，敬请期待。</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
