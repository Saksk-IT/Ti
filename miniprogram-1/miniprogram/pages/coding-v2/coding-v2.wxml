<!--coding-v2.wxml - 占位 -->
<view class="page-root mine-linked-page {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="编程" back="{{true}}" compact="{{true}}" color="var(--app-nav-fg)" background="transparent">
    <view slot="right" class="nav-right">
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <view class="page-container">
    <scroll-view class="content-area" scroll-y bounces="{{false}}">
      <view class="container">
        <view class="card hero" aria-label="编程模式">
          <text class="hero-title">编程</text>
          <text class="hero-sub">代码练习入口，后续与 Web 编程模块保持同一套题目与进度语义。</text>
        </view>

        <view class="card section-card" aria-label="状态说明">
          <text class="section-title">当前状态</text>
          <text class="section-sub">该模块已在 Web 端上线，小程序端将按相同语义接入（题目 / 收藏 / 错题 / 进度 / 考试）。</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
