<!-- settings-center-v2.wxml - 设置子页面合并为同页 Tab 切换，避免路由级白屏 -->
<view class="page-root {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="设置" back="{{false}}" color="var(--app-nav-fg)" background="var(--app-bg)">
    <view slot="left" class="nav-left">
      <view class="icon-btn" bindtap="onHamburgerTap" aria-role="button" aria-label="打开侧边栏">
        <view class="icon-hamburger"></view>
      </view>
      <view class="icon-btn" bindtap="onToggleDarkTap" aria-role="button" aria-label="切换深色模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
      </view>
    </view>
  </navigation-bar>

  <v2-drawer
    open="{{drawerOpen}}"
    themeStyle="{{themeStyle}}"
    activeKey="settings"
    bind:close="onDrawerClose"
    bind:navigate="onDrawerNavigate"
    bind:selectstyle="onDrawerSelectStyle"
  />

  <view class="page-container">
    <scroll-view
      class="content-area"
      scroll-y
      bounces="{{false}}"
      refresher-enabled="{{true}}"
      bindrefresherrefresh="onPullDownRefresh"
      scroll-top="{{scrollTop}}"
    >
      <view class="container">
        <!-- Hero -->
        <block wx:if="{{navKey==='account'}}">
          <view class="card hero" aria-label="账号设置概览">
            <text class="hero-title">{{accTab==='profile' ? '个人资料' : (accTab==='security' ? '账号安全' : '账号绑定')}}</text>
            <text class="hero-sub">
              {{accTab==='profile' ? '头像、昵称、学院与个人签名等信息。' : (accTab==='security' ? '用于修改或设置登录密码。' : '管理邮箱与微信绑定状态。')}}
            </text>
          </view>
        </block>
        <view class="card hero" wx:elif="{{navKey==='practice'}}" aria-label="通用设置概览">
          <text class="hero-title">通用</text>
          <text class="hero-sub">通用设置与基础操作。</text>
        </view>
        <view class="card hero" wx:elif="{{navKey==='theme'}}" aria-label="主题设置概览">
          <text class="hero-title">主题</text>
          <text class="hero-sub">调整页面主色与背景氛围。</text>
        </view>
        <view class="card hero" wx:else aria-label="关于页概览">
          <text class="hero-title">关于</text>
          <text class="hero-sub">应用信息与相关协议。</text>
        </view>

        <view class="card nav-card" aria-label="设置分区导航">
          <view class="tabs">
            <view class="tab {{navKey==='account' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="account"><text>账号管理</text></view>
            <view class="tab {{navKey==='practice' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="practice"><text>通用</text></view>
            <view class="tab {{navKey==='theme' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="theme"><text>主题</text></view>
            <view class="tab {{navKey==='about' ? 'active' : ''}}" bindtap="onSettingsNavTap" data-key="about"><text>关于</text></view>
          </view>
        </view>

        <view class="subtabs" aria-label="账号管理子导航" wx:if="{{navKey==='account'}}">
          <view class="subtab {{accTab==='profile' ? 'active' : ''}}" bindtap="onAccountSubTap" data-key="profile"><text>个人资料</text></view>
          <view class="subtab {{accTab==='security' ? 'active' : ''}}" bindtap="onAccountSubTap" data-key="security"><text>账号安全</text></view>
          <view class="subtab {{accTab==='bindings' ? 'active' : ''}}" bindtap="onAccountSubTap" data-key="bindings"><text>账号绑定</text></view>
        </view>

        <view class="subtabs" aria-label="关于分区" wx:if="{{navKey==='about'}}">
          <view class="subtab {{aboutTab==='app' ? 'active' : ''}}" bindtap="onAboutTabTap" data-tab="app"><text>应用信息</text></view>
          <view class="subtab {{aboutTab==='legal' ? 'active' : ''}}" bindtap="onAboutTabTap" data-tab="legal"><text>协议</text></view>
        </view>

        <!-- 账号：个人资料 -->
        <view class="tab-panel" wx:if="{{profileMounted}}" hidden="{{!(navKey==='account' && accTab==='profile')}}">
          <view class="msg error" wx:if="{{profile.errorMsg}}">
            <text>{{profile.errorMsg}}</text>
          </view>
          <view class="msg" wx:if="{{profile.msg}}">
            <text>{{profile.msg}}</text>
          </view>

          <view class="card section-card" aria-label="资料">
            <text class="section-title">资料</text>
            <text class="section-sub">用于展示与账号识别。仅包含必要信息。</text>
            <view class="divider"></view>

            <view class="profile-head">
              <view class="avatar-btn" bindtap="onAvatarTap" aria-role="button" aria-label="头像操作">
                <image class="avatar-img" wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" lazy-load="{{true}}"></image>
                <view class="avatar-text" wx:else><text>{{profile.avatarInitial}}</text></view>
                <view class="avatar-overlay"><text>更换</text></view>
              </view>

              <view class="profile-meta">
                <text class="profile-name">{{profile.username}}</text>
                <view class="profile-meta-row">
                  <view class="profile-chip"><text>{{profile.roleText}}</text></view>
                  <view class="profile-chip"><text>{{profile.createdAtText}}</text></view>
                </view>
              </view>

              <view class="profile-actions">
                <view class="btn btn-quiet" wx:if="{{!profile.editing}}" bindtap="onEdit"><text>编辑</text></view>
                <view class="btn btn-primary {{profile.saving ? 'disabled' : ''}}" wx:if="{{profile.editing}}" bindtap="onSave"><text>{{profile.saving ? '保存中…' : '保存'}}</text></view>
                <view class="btn" wx:if="{{profile.editing}}" bindtap="onCancel"><text>取消</text></view>
              </view>
            </view>

            <view class="profile-grid">
              <view class="acc-field">
                <text class="acc-label">昵称</text>
                <input class="acc-input" value="{{profile.username}}" disabled="{{true}}" />
                <text class="acc-help">昵称由系统账号标识决定，当前不支持在此页修改。</text>
              </view>

              <view class="acc-field">
                <text class="acc-label">学院</text>
                <input class="acc-input" value="{{profile.college}}" disabled="{{!profile.editing}}" placeholder="未设置" placeholder-class="placeholder" maxlength="40" bindinput="onCollegeInput" />
              </view>

              <view class="acc-field span-2">
                <view class="sig-row">
                  <text class="acc-label">个人签名</text>
                  <text class="sig-count">{{profile.signatureCount}}/80</text>
                </view>
                <textarea
                  class="acc-textarea"
                  value="{{profile.signature}}"
                  disabled="{{!profile.editing}}"
                  placeholder="未设置"
                  placeholder-class="placeholder"
                  maxlength="80"
                  bindinput="onSignatureInput"
                ></textarea>
              </view>

              <view class="acc-field span-2">
                <text class="acc-label">联系方式</text>
                <input class="acc-input" value="{{profile.contact}}" disabled="{{!profile.editing}}" placeholder="未设置" placeholder-class="placeholder" maxlength="60" bindinput="onContactInput" />
              </view>
            </view>
          </view>

          <view class="card section-card" aria-label="账号状态">
            <text class="section-title">账号状态</text>
            <text class="section-sub">用于识别与安全状态。</text>
            <view class="divider"></view>

            <view class="status-list">
              <view class="status-row">
                <text class="status-label">邮箱</text>
                <text class="status-value">{{profile.emailMasked}}</text>
                <text class="status-badge">{{profile.emailBadge}}</text>
              </view>
              <view class="status-row">
                <text class="status-label">登录密码</text>
                <text class="status-value muted">{{profile.passwordBadge}}</text>
              </view>
              <view class="status-row">
                <text class="status-label">微信绑定</text>
                <text class="status-value muted">{{profile.wechatBadge}}</text>
              </view>
            </view>

            <view class="panel-actions">
              <view class="btn btn-quiet" bindtap="onAccountSubTap" data-key="security" aria-role="button" aria-label="前往账号安全"><text>账号安全</text></view>
              <view class="btn" bindtap="onAccountSubTap" data-key="bindings" aria-role="button" aria-label="前往账号绑定"><text>账号绑定</text></view>
            </view>
          </view>
        </view>

        <!-- 账号：账号安全 -->
        <view class="tab-panel" wx:if="{{securityMounted}}" hidden="{{!(navKey==='account' && accTab==='security')}}">
          <view class="msg error" wx:if="{{security.errorMsg}}">
            <text>{{security.errorMsg}}</text>
          </view>
          <view class="msg" wx:if="{{security.msg}}">
            <text>{{security.msg}}</text>
          </view>

          <view class="card section-card" aria-label="密码设置">
            <view class="section-head">
              <view class="section-head-left">
                <text class="section-title">密码</text>
                <text class="section-sub">{{security.pwdSub}}</text>
              </view>
              <view class="status-chip" aria-label="密码状态">
                <text>{{security.pwdChip}}</text>
              </view>
            </view>

            <view class="divider"></view>

            <view class="form-grid">
              <view class="acc-field" wx:if="{{security.hasPasswordSet}}">
                <text class="acc-label">当前密码</text>
                <view class="input-row">
                  <input
                    class="acc-input"
                    value="{{security.currentPassword}}"
                    password="{{!security.showCurrent}}"
                    placeholder="请输入当前密码"
                    placeholder-class="placeholder"
                    bindinput="onCurrentInput"
                  />
                  <view class="mini-btn" bindtap="onToggleShow" data-target="current" aria-role="button" aria-label="显示或隐藏当前密码">
                    <text>{{security.showCurrent ? '隐藏' : '显示'}}</text>
                  </view>
                </view>
              </view>

              <view class="acc-field">
                <text class="acc-label">新密码</text>
                <view class="input-row">
                  <input
                    class="acc-input"
                    value="{{security.newPassword}}"
                    password="{{!security.showNew}}"
                    placeholder="请输入新密码"
                    placeholder-class="placeholder"
                    bindinput="onNewInput"
                  />
                  <view class="mini-btn" bindtap="onToggleShow" data-target="new" aria-role="button" aria-label="显示或隐藏新密码">
                    <text>{{security.showNew ? '隐藏' : '显示'}}</text>
                  </view>
                </view>
                <text class="acc-help">至少 8 位，且同时包含字母与数字。</text>
              </view>

              <view class="acc-field">
                <text class="acc-label">确认新密码</text>
                <view class="input-row">
                  <input
                    class="acc-input"
                    value="{{security.confirmPassword}}"
                    password="{{!security.showConfirm}}"
                    placeholder="请再次输入新密码"
                    placeholder-class="placeholder"
                    bindinput="onConfirmInput"
                  />
                  <view class="mini-btn" bindtap="onToggleShow" data-target="confirm" aria-role="button" aria-label="显示或隐藏确认密码">
                    <text>{{security.showConfirm ? '隐藏' : '显示'}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="divider"></view>

            <view class="form-actions">
              <view class="btn btn-primary {{security.submitting ? 'disabled' : ''}}" bindtap="onSubmit" aria-role="button" aria-label="提交密码">
                <text>{{security.submitText}}</text>
              </view>
              <view class="btn btn-quiet {{security.submitting ? 'disabled' : ''}}" bindtap="onReset" aria-role="button" aria-label="清空表单">
                <text>清空</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 账号：账号绑定 -->
        <view class="tab-panel" wx:if="{{bindingsMounted}}" hidden="{{!(navKey==='account' && accTab==='bindings')}}">
          <view class="msg error" wx:if="{{bindings.errorMsg}}">
            <text>{{bindings.errorMsg}}</text>
          </view>
          <view class="msg" wx:if="{{bindings.msg}}">
            <text>{{bindings.msg}}</text>
          </view>

          <!-- 邮箱 -->
          <view class="card section-card" aria-label="邮箱绑定">
            <view class="bind-row">
              <view class="bind-meta">
                <text class="bind-name">邮箱</text>
                <text class="bind-desc">{{bindings.emailDesc}}</text>
              </view>
              <view class="bind-actions">
                <view class="status-chip"><text>{{bindings.emailChip}}</text></view>
                <view class="btn btn-quiet {{bindings.loading ? 'disabled' : ''}}" bindtap="onEmailActionTap" aria-role="button" aria-label="绑定或更换邮箱">
                  <text>{{bindings.emailActionText}}</text>
                </view>
              </view>
            </view>

            <view class="bind-form" wx:if="{{bindings.emailFormOpen}}">
              <view class="divider"></view>
              <view class="form-grid">
                <view class="acc-field">
                  <text class="acc-label">邮箱地址</text>
                  <input
                    class="acc-input"
                    value="{{bindings.bindEmail}}"
                    type="text"
                    placeholder="请输入邮箱地址"
                    placeholder-class="placeholder"
                    bindinput="onBindEmailInput"
                  />
                </view>

                <view class="acc-field">
                  <text class="acc-label">验证码</text>
                  <view class="input-row">
                    <input
                      class="acc-input"
                      value="{{bindings.bindCode}}"
                      type="number"
                      maxlength="6"
                      placeholder="6 位验证码"
                      placeholder-class="placeholder"
                      bindinput="onBindCodeInput"
                    />
                    <view class="mini-btn {{bindings.sendCodeDisabled ? 'disabled' : ''}}" bindtap="onSendCodeTap" aria-role="button" aria-label="发送验证码">
                      <text>{{bindings.sendCodeText}}</text>
                    </view>
                  </view>
                </view>

                <view class="form-actions">
                  <view class="btn btn-primary {{bindings.bindingEmail ? 'disabled' : ''}}" bindtap="onBindEmailTap" aria-role="button" aria-label="确认绑定邮箱">
                    <text>{{bindings.bindingEmail ? '绑定中…' : '确认绑定'}}</text>
                  </view>
                  <view class="btn {{bindings.bindingEmail ? 'disabled' : ''}}" bindtap="onCloseEmailFormTap" aria-role="button" aria-label="取消绑定邮箱">
                    <text>取消</text>
                  </view>
                </view>

                <text class="acc-help">绑定邮箱用于接收验证码与找回账号。</text>
              </view>
            </view>
          </view>

          <!-- 微信 -->
          <view class="card section-card" aria-label="微信绑定">
            <view class="bind-row">
              <view class="bind-meta">
                <text class="bind-name">微信</text>
                <text class="bind-desc">{{bindings.wechatDesc}}</text>
              </view>
              <view class="bind-actions">
                <view class="status-chip"><text>{{bindings.wechatChip}}</text></view>
                <view class="btn btn-quiet {{bindings.bindingWechat ? 'disabled' : ''}}" wx:if="{{!bindings.wechatBound}}" bindtap="onWechatBindTap" aria-role="button" aria-label="绑定微信">
                  <text>{{bindings.bindingWechat ? '绑定中…' : '一键绑定'}}</text>
                </view>
                <view class="btn {{bindings.unbindingWechat ? 'disabled' : ''}}" wx:if="{{bindings.wechatBound}}" bindtap="onWechatUnbindTap" aria-role="button" aria-label="解绑微信">
                  <text>{{bindings.unbindingWechat ? '解绑中…' : '解绑'}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 通用 -->
        <view class="tab-panel" wx:if="{{practiceMounted}}" hidden="{{navKey!=='practice'}}">
          <view class="msg" wx:if="{{practice.msg}}">
            <text>{{practice.msg}}</text>
          </view>
          <view class="card section-card" aria-label="待开发">
            <text class="section-title">待开发</text>
            <text class="section-sub">该页面功能正在完善中，敬请期待。</text>
          </view>
        </view>

        <!-- 主题 -->
        <view class="tab-panel" wx:if="{{themeMounted}}" hidden="{{navKey!=='theme'}}">
          <view class="msg" wx:if="{{theme.msg}}">
            <text>{{theme.msg}}</text>
          </view>

          <view class="card section-card" aria-label="页面风格主题">
            <text class="section-title">页面风格</text>
            <text class="section-sub">调整页面主色与背景氛围（已登录时与 Web 端同步）。</text>
            <view class="chips">
              <view class="chip {{themeStyle==='default' ? 'active' : ''}}" bindtap="onStyleTap" data-style="default"><text>灰白</text></view>
              <view class="chip {{themeStyle==='mist' ? 'active' : ''}}" bindtap="onStyleTap" data-style="mist"><text>雾蓝</text></view>
              <view class="chip {{themeStyle==='dune' ? 'active' : ''}}" bindtap="onStyleTap" data-style="dune"><text>暖砂</text></view>
              <view class="chip {{themeStyle==='pine' ? 'active' : ''}}" bindtap="onStyleTap" data-style="pine"><text>岩松</text></view>
              <view class="chip {{themeStyle==='celadon' ? 'active' : ''}}" bindtap="onStyleTap" data-style="celadon"><text>影青</text></view>
              <view class="chip {{themeStyle==='dark' ? 'active' : ''}}" bindtap="onStyleTap" data-style="dark"><text>深色</text></view>
            </view>
          </view>

          <view class="card section-card" aria-label="字体样式">
            <text class="section-title">字体样式</text>
            <text class="section-sub">调整全局字体风格（本机生效，不同步）。</text>
            <view class="msg" wx:if="{{font.msg}}">
              <text>{{font.msg}}</text>
            </view>
            <view class="font-chips">
              <view
                class="font-chip {{fontStyle===item.id ? 'active' : ''}}"
                wx:for="{{fontStyleList}}"
                wx:key="id"
                bindtap="onFontStyleTap"
                data-style="{{item.id}}"
              >
                <text class="font-chip-name">{{item.name}}</text>
                <text class="font-chip-desc">{{item.description}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 关于 -->
        <view class="tab-panel" wx:if="{{aboutMounted}}" hidden="{{navKey!=='about'}}">
          <view class="msg error" wx:if="{{about.errorMsg}}">
            <text>{{about.errorMsg}}</text>
          </view>

          <view class="card section-card" wx:if="{{aboutTab==='app'}}" aria-label="应用信息">
            <text class="section-title">应用信息</text>
            <text class="section-sub">保持专注的练习体验与一致的数据语义。</text>
            <view class="divider"></view>

            <view class="about-row">
              <view class="about-left">
                <text class="about-name">产品</text>
                <text class="about-desc">SAK 题库与练习系统</text>
              </view>
              <text class="about-link">小程序</text>
            </view>

            <view class="about-row">
              <view class="about-left">
                <text class="about-name">当前账号</text>
                <text class="about-desc">{{about.currentUsername}}</text>
              </view>
              <view class="about-link tap" bindtap="onGoProfile"><text>查看</text></view>
            </view>

            <view class="about-row tap" bindtap="onToggleContact">
              <view class="about-left">
                <text class="about-name">联系管理员</text>
                <text class="about-desc">点击展开站内 Chat、邮箱、微信联系方式。</text>
              </view>
              <view class="about-toggle">
                <text class="about-link">联系</text>
                <view class="toggle-icon {{about.contactOpen ? 'open' : ''}}"><text>+</text></view>
              </view>
            </view>

            <view class="contact-panel" wx:if="{{about.contactOpen}}">
              <text class="contact-meta">当前管理员：{{about.adminUsername || '未设置'}}</text>

              <view class="contact-item">
                <view class="contact-left">
                  <text class="contact-title">站内 Chat</text>
                  <text class="contact-desc">小程序暂不支持站内聊天，可在 Web 端发起。</text>
                </view>
                <view class="contact-right">
                  <view class="btn btn-primary {{about.chatDisabled ? 'disabled' : ''}}" bindtap="onContactChat">
                    <text>{{about.chatDisabled ? '不可用' : '开始聊天'}}</text>
                  </view>
                </view>
              </view>

              <view class="contact-item">
                <view class="contact-left">
                  <text class="contact-title">邮箱</text>
                  <text class="contact-desc">发送问题与建议到管理员邮箱。</text>
                </view>
                <view class="contact-right">
                  <view class="contact-value {{about.adminEmail ? '' : 'muted'}}" bindtap="onCopy" data-value="{{about.adminEmail}}">
                    <text>{{about.adminEmail || '未设置'}}</text>
                  </view>
                </view>
              </view>

              <view class="contact-item">
                <view class="contact-left">
                  <text class="contact-title">微信</text>
                  <text class="contact-desc">添加管理员微信进行沟通。</text>
                </view>
                <view class="contact-right">
                  <view class="contact-value {{about.adminWechat ? '' : 'muted'}}" bindtap="onCopy" data-value="{{about.adminWechat}}">
                    <text>{{about.adminWechat || '未设置'}}</text>
                  </view>
                </view>
              </view>

              <text class="contact-meta" wx:if="{{about.chatDisabled && about.chatDisabledReason}}">{{about.chatDisabledReason}}</text>
            </view>
          </view>

          <view class="card section-card" wx:if="{{aboutTab==='legal'}}" aria-label="协议">
            <text class="section-title">协议</text>
            <text class="section-sub">使用前请阅读并理解相关条款。</text>
            <view class="divider"></view>

            <view class="about-row tap" bindtap="onOpenTerms">
              <view class="about-left">
                <text class="about-name">服务协议</text>
                <text class="about-desc">产品服务条款与用户责任。</text>
              </view>
              <text class="about-link">查看</text>
            </view>

            <view class="about-row tap" bindtap="onOpenPrivacy">
              <view class="about-left">
                <text class="about-name">隐私保护协议</text>
                <text class="about-desc">数据处理与隐私说明。</text>
              </view>
              <text class="about-link">查看</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

