<view class="page-root campus-page campus-query-page campus-schedule-page {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <view class="campus-bg"></view>
  <navigation-bar title="{{pageTitle}}" back="{{true}}" compact="{{true}}" color="var(--app-nav-fg)" background="transparent">
    <view slot="right" class="nav-right schedule-nav-right">
      <view class="icon-btn" bindtap="onOpenScheduleTermSheetTap" aria-role="button" aria-label="切换学年学期">
        <image class="icon" src="/images/icons/sliders.svg" mode="aspectFit"></image>
      </view>
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <view class="page-container">
    <scroll-view class="content-area" scroll-y bounces="{{false}}" refresher-enabled="{{true}}" bindrefresherrefresh="onRefresh">
      <view class="container query-container">
        <view class="schedule-control-band">
          <view class="schedule-term-summary">
            <text class="schedule-term-title">{{selectedTermLabel}}</text>
            <text class="schedule-term-sub">第 {{selectedWeek}} 周 · {{selectedWeekDateRange}}</text>
          </view>
          <view class="schedule-view-toggle" bindtap="onScheduleViewToggleTap" aria-role="button" aria-label="切换课表显示方式">
            <image class="schedule-view-icon" src="{{scheduleViewMode === 'table' ? '/images/icons/list.svg' : '/images/icons/bar-chart.svg'}}" mode="aspectFit"></image>
            <text>{{scheduleViewMode === 'table' ? '列表' : '课程表'}}</text>
          </view>
        </view>

        <view class="schedule-week-panel">
          <picker class="week-picker" mode="selector" range="{{weekLabels}}" value="{{selectedWeekIndex}}" bindchange="onWeekChange">
            <view class="week-trigger" aria-role="button" aria-label="选择周次">
              <text class="week-label">周次</text>
              <text class="week-value">第 {{selectedWeek}} 周</text>
            </view>
          </picker>
          <picker class="week-start-picker" mode="date" value="{{weekStartDate}}" bindchange="onWeekStartDateChange">
            <view class="week-trigger" aria-role="button" aria-label="设置第一周开始日期">
              <text class="week-label">第一周</text>
              <text class="week-value">{{weekStartDate}}</text>
            </view>
          </picker>
        </view>

        <view class="campus-query-progress" wx:if="{{queryProgressVisible}}">
          <view class="progress-head">
            <view class="progress-title-wrap">
              <image class="progress-icon" src="/images/icons/refresh-cw.svg" mode="aspectFit"></image>
              <text class="progress-title">查询进度</text>
            </view>
            <text class="progress-status">{{queryProgressStatus}}</text>
          </view>
          <view class="query-progress-track">
            <view class="query-progress-fill" style="width: {{queryProgressPercent}}%;"></view>
          </view>
          <text class="progress-detail">{{queryProgressDetail}}</text>
          <text class="progress-meta" wx:if="{{queryProgressMeta}}">{{queryProgressMeta}}</text>
        </view>

        <view class="msg error" wx:if="{{errorMsg}}">
          <text>{{errorMsg}}</text>
        </view>

        <view class="bind-prompt" wx:if="{{statusReady && !statusFailed && !eduBound && !statusLoading}}">
          <view class="prompt-head">
            <view class="prompt-icon-wrap">
              <image class="prompt-icon" src="/images/icons/settings.svg" mode="aspectFit"></image>
            </view>
            <view class="prompt-copy">
              <text class="prompt-title">未绑定教务系统账号</text>
              <text class="prompt-sub">绑定后可在此查询课表。</text>
            </view>
          </view>
          <view class="prompt-action" bindtap="onGoEduBindingTap" aria-role="button" aria-label="去绑定教务系统账号">
            <image class="prompt-action-icon" src="/images/icons/settings.svg" mode="aspectFit"></image>
            <text>去绑定</text>
          </view>
        </view>

        <view class="snapshot-browser" wx:if="{{snapshotTerms.length}}">
          <view class="snapshot-selector-group" aria-label="历史课表筛选">
            <scroll-view class="snapshot-selector-scroll snapshot-term-list" scroll-x show-scrollbar="{{false}}" enhanced="{{true}}">
              <view class="snapshot-chip-row">
                <view
                  class="snapshot-chip snapshot-term-chip {{item.active ? 'active' : ''}}"
                  wx:for="{{snapshotTerms}}"
                  wx:key="value"
                  data-value="{{item.value}}"
                  bindtap="onSnapshotTermTap"
                  aria-role="button"
                  aria-label="选择{{item.label}}"
                >
                  <text>{{item.label}}</text>
                  <text class="chip-count">{{item.count}}</text>
                </view>
              </view>
            </scroll-view>
          </view>
        </view>

        <block wx:if="{{scheduleViewMode === 'list'}}">
          <view class="term-list" wx:if="{{visibleScheduleResults.length}}">
            <view class="term-card" wx:for="{{visibleScheduleResults}}" wx:key="title">
              <view class="term-head">
                <text class="term-title">{{item.title}}</text>
                <text class="term-meta" wx:if="{{item.studentText}}">{{item.studentText}}</text>
              </view>
              <view class="day-block" wx:for="{{item.weekRows}}" wx:for-item="dayRow" wx:key="day">
                <text class="day-title">{{dayRow.day}}</text>
                <view class="section-row" wx:for="{{dayRow.sections}}" wx:for-item="sectionRow" wx:key="section">
                  <text class="section-label">{{sectionRow.section}}</text>
                  <view class="course-list">
                    <view class="course-chip" wx:for="{{sectionRow.courses}}" wx:for-item="course" wx:key="course_name">
                      <text class="course-name">{{course.course_name}}</text>
                      <text class="course-detail">{{course.teacher || '-'}} / {{course.location || '-'}} / {{course.weeks || '-'}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="practice-block" wx:if="{{item.practice_courses.length}}">
                <text class="practice-title">集中实践</text>
                <view class="course-chip" wx:for="{{item.practice_courses}}" wx:for-item="course" wx:key="course_name">
                  <text class="course-name">{{course.course_name}}</text>
                  <text class="course-detail">{{course.teacher || '-'}} / {{course.weeks || '-'}}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="empty-state" wx:elif="{{eduBound && !loading}}">
            <text>暂无本周课表记录。</text>
          </view>
        </block>

        <block wx:else>
          <view class="schedule-table-shell" wx:if="{{scheduleTableRows.length}}">
            <scroll-view class="schedule-table-scroll" scroll-x show-scrollbar="{{false}}" enhanced="{{true}}">
              <view class="schedule-table-grid">
                <view class="schedule-table-row table-head-row">
                  <view class="schedule-table-cell section-head-cell">
                    <text>节次</text>
                  </view>
                  <view class="schedule-table-cell day-head-cell" wx:for="{{scheduleTableDays}}" wx:key="*this">
                    <text>{{item}}</text>
                  </view>
                </view>
                <view class="schedule-table-row" wx:for="{{scheduleTableRows}}" wx:key="key" wx:for-item="row">
                  <view class="schedule-table-cell section-head-cell">
                    <text>{{row.section}}</text>
                  </view>
                  <view class="schedule-table-cell course-table-cell {{cell.hasCourses ? 'has-course' : ''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="key">
                    <view class="table-course" wx:for="{{cell.courses}}" wx:for-item="course" wx:key="course_name">
                      <text class="table-course-name">{{course.course_name}}</text>
                      <text class="table-course-detail">{{course.location || '-'}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </scroll-view>
          </view>
          <block wx:for="{{visibleScheduleResults}}" wx:for-item="termItem" wx:key="title">
            <view class="practice-block table-practice-block" wx:if="{{termItem.practice_courses.length}}">
              <text class="practice-title">{{termItem.title}} · 集中实践</text>
              <view class="course-chip" wx:for="{{termItem.practice_courses}}" wx:for-item="course" wx:key="course_name">
                <text class="course-name">{{course.course_name}}</text>
                <text class="course-detail">{{course.teacher || '-'}} / {{course.weeks || '-'}}</text>
              </view>
            </view>
          </block>
          <view class="empty-state" wx:if="{{!scheduleTableRows.length && eduBound && !loading && !visibleScheduleResults.length}}">
            <text>暂无本周课程表记录。</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="floating-query-bubble {{loading ? 'disabled' : ''}}" bindtap="onQueryTap" aria-role="button" aria-label="查询课表">
    <image class="floating-query-icon" src="/images/icons/book-open.svg" mode="aspectFit"></image>
    <text>{{loading ? '提交中...' : '查询课表'}}</text>
  </view>

  <view class="schedule-term-sheet" wx:if="{{scheduleTermSheetVisible}}">
    <view class="sheet-mask" bindtap="onCloseScheduleTermSheetTap"></view>
    <view class="schedule-sheet-panel">
      <view class="sheet-head">
        <text class="sheet-title">{{scheduleTermSheetMode === 'query' ? '查询课表' : '切换学期'}}</text>
        <text class="sheet-sub">{{selectedTermLabel}}</text>
      </view>
      <view class="sheet-picker-row">
        <picker class="year-picker" mode="selector" range="{{academicYearLabels}}" value="{{academicYearIndex}}" bindchange="onAcademicYearChange">
          <view class="year-trigger" aria-role="button" aria-label="选择学年">
            <view class="field-copy">
              <text class="field-label">学年</text>
              <text class="year-value">{{academicYearLabels[academicYearIndex]}}</text>
            </view>
            <text class="chevron">⌄</text>
          </view>
        </picker>
        <picker class="semester-picker" mode="selector" range="{{semesterLabels}}" value="{{semesterIndex}}" bindchange="onSemesterChange">
          <view class="semester-trigger" aria-role="button" aria-label="选择学期">
            <view class="field-copy">
              <text class="field-label">学期</text>
              <text class="semester-value">{{semesterLabels[semesterIndex]}}</text>
            </view>
            <text class="chevron">⌄</text>
          </view>
        </picker>
      </view>
      <view class="sheet-actions">
        <view class="sheet-action ghost" bindtap="onCloseScheduleTermSheetTap" aria-role="button" aria-label="取消">取消</view>
        <view class="sheet-action primary" bindtap="onScheduleTermSheetConfirmTap" aria-role="button" aria-label="确认">
          {{scheduleTermSheetMode === 'query' ? '开始查询' : '切换显示'}}
        </view>
      </view>
    </view>
  </view>

  <view class="campus-captcha-dialog" wx:if="{{captchaVisible}}">
    <view class="captcha-mask" bindtap="onCaptchaCancelTap"></view>
    <view class="captcha-panel">
      <view class="captcha-head">
        <text class="captcha-title">输入 WebVPN 验证码</text>
        <text class="captcha-sub">课表查询需要刷新登录态</text>
      </view>
      <text class="captcha-message">{{captchaMessage}}</text>
      <image class="captcha-image" wx:if="{{captchaImage}}" src="{{captchaImage}}" mode="aspectFit"></image>
      <input class="captcha-input" value="{{captchaCode}}" maxlength="10" placeholder="请输入验证码" bindinput="onCaptchaInput" />
      <view class="captcha-actions">
        <view class="captcha-action ghost" bindtap="onCaptchaCancelTap" aria-role="button" aria-label="取消验证码输入">取消</view>
        <view class="captcha-action primary {{captchaSubmitting ? 'disabled' : ''}}" bindtap="onCaptchaSubmitTap" aria-role="button" aria-label="提交验证码">
          {{captchaSubmitting ? '提交中...' : '继续查询'}}
        </view>
      </view>
    </view>
  </view>
</view>
