                <view class="dc-item-top">
                  <view style="min-width:0;">
                    <text class="dc-item-title">{{it.scope_label}} · {{it.name}}</text>
                    <text class="dc-item-meta">收藏 {{it.count}}</text>
                  </view>
                  <view class="dc-item-actions">
                    <view class="dc-mini-btn primary" wx:if="{{it.can_quiz_bank}}" bindtap="onGoBankFavorites" data-bank-id="{{it.bank_id}}" aria-role="button"><text>刷收藏</text></view>
                    <view class="dc-mini-btn" wx:else bindtap="onGoFavoritesCenter" aria-role="button"><text>去中心下钻</text></view>
                  </view>
                </view>
                <view class="dc-bars" aria-hidden="true">
                  <view class="dc-bar">
                    <view class="dc-bar-inner" style="width: {{it.bar_pct}}%;"></view>
                  </view>
                </view>
              </view>
            </view>
            <view class="dc-empty" wx:else>暂无可用收藏排行数据。</view>
          </view>

          <view class="dc-card dc-span-6" aria-label="最近收藏（公共/个人）">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">最近收藏</text>
              </view>
            </view>

            <view class="dc-bento" aria-label="最近收藏列表">
              <view class="dc-span-6">
                <view class="dc-card-head">
                  <view style="min-width:0;">
                    <text class="dc-h3">公共题库</text>
                  </view>
                </view>
                <view class="dc-list" wx:if="{{recent_favorites_public.length}}">
                  <view class="dc-item" wx:for="{{recent_favorites_public}}" wx:for-item="f" wx:key="key">
                    <view class="dc-item-top">
                      <view style="min-width:0;">
                        <text class="dc-item-title">{{f.subject}} · {{f.q_type}} · 难度{{f.difficulty}}</text>
                        <text class="dc-item-meta">{{f.snippet}}</text>
                      </view>
                      <view class="dc-item-actions">
                        <view class="dc-mini-btn primary" bindtap="onGoFavoritesCenter" aria-role="button"><text>去中心</text></view>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="dc-empty" wx:else>暂无收藏记录。</view>
              </view>

              <view class="dc-span-6">
                <view class="dc-card-head">
                  <view style="min-width:0;">
                    <text class="dc-h3">个人题库</text>
                  </view>
                </view>
                <view class="dc-list" wx:if="{{recent_favorites_bank.length}}">
                  <view class="dc-item" wx:for="{{recent_favorites_bank}}" wx:for-item="f" wx:key="key">
                    <view class="dc-item-top">
                      <view style="min-width:0;">
                        <text class="dc-item-title">{{f.bank_name}} · {{f.q_type}} · 难度{{f.difficulty}}</text>
                        <text class="dc-item-meta">{{f.snippet}}</text>
                      </view>
                      <view class="dc-item-actions">
                        <view class="dc-mini-btn primary" bindtap="onGoQuizBankFavorites" data-bank-id="{{f.bank_id}}" aria-role="button"><text>刷收藏</text></view>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="dc-empty" wx:else>暂无个人题库收藏记录。</view>
              </view>
            </view>
          </view>
          </block>
        </view>
        </block>
        <block wx:else>
        <view class="dc-bento" aria-label="标签数据看板">
          <view class="dc-card dc-span-4" aria-label="标签总览">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">标签总览</text>
              </view>
              <view class="dc-mini-btn" bindtap="onGoTagsCenter" aria-role="button"><text>标签中心</text></view>
            </view>

            <view class="dc-list">
              <view class="dc-item">
                <view class="dc-item-top">
                  <view style="min-width:0;">
                    <text class="dc-item-title">标签总数</text>
                    <text class="dc-item-meta"> {{tags_kpis.all_tag_count}}（公共 {{tags_kpis.public_tag_count}} · 个人 {{tags_kpis.banks_tag_count}}）</text>
                  </view>
                </view>
              </view>
              <view class="dc-item">
                <view class="dc-item-top">
                  <view style="min-width:0;">
                    <text class="dc-item-title">已打标签题目</text>
                    <text class="dc-item-meta">{{tags_kpis.all_tagged_questions}}（公共 {{tags_kpis.public_tagged_questions}} · 个人 {{tags_kpis.banks_tagged_questions}}）</text>
                  </view>
                </view>
              </view>
              <view class="dc-item">
                <view class="dc-item-top">
                  <view style="min-width:0;">
                    <text class="dc-item-title">标签覆盖率</text>
                    <text class="dc-item-meta">{{tags_kpis.tagged_answered_coverage}}%（已做题中：有标签的比例）</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="dc-item-actions" style="margin-top:20rpx;">
              <view class="dc-mini-btn primary" bindtap="onGoTagsCenter" aria-role="button"><text>去整理标签</text></view>
              <view class="dc-mini-btn" bindtap="onTabTap" data-tab="global" aria-role="button"><text>回全局</text></view>
            </view>
          </view>

          <view class="dc-card dc-span-8" aria-label="标签共现网络">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">标签共现网络</text>
              </view>
            </view>
            <view class="dc-chart lg" aria-label="标签共现网络图">
              <ec-canvas id="dcTagGraphChart" canvas-id="dcTagGraphChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-12 dc-lazy-card" wx:if="{{lazyStage < 2}}" id="dcLazyStage2Trigger" aria-label="继续下滑加载更多">
            <text class="dc-lazy-title">继续下滑加载更多</text>
            <text class="dc-lazy-sub">下方结构图与榜单将按需渲染</text>
          </view>

          <block wx:if="{{lazyStage >= 2}}">
          <view class="dc-card dc-span-6" aria-label="标签结构（Treemap）">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">标签结构</text>
              </view>
            </view>
            <view class="dc-chart lg" aria-label="标签结构 Treemap">
              <ec-canvas id="dcTagTreemapChart" canvas-id="dcTagTreemapChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-6" aria-label="标签 Top">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">标签 Top</text>
              </view>
            </view>
            <view class="dc-chart lg" aria-label="标签 Top 图">
              <ec-canvas id="dcTagTopChart" canvas-id="dcTagTopChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-12" aria-label="标签质量（正确率/覆盖）">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">标签质量</text>
              </view>
            </view>
            <view class="dc-chart lg" aria-label="标签质量散点图">
              <ec-canvas id="dcTagAccuracyChart" canvas-id="dcTagAccuracyChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-12" aria-label="标签列表（公共/个人）">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">标签列表</text>
              </view>
            </view>

            <view class="dc-bento" aria-label="标签列表分栏">
              <view class="dc-span-6">
                <view class="dc-card-head">
                  <view style="min-width:0;">
                    <text class="dc-h3">公共题库标签</text>
                  </view>
                </view>
                <view class="dc-list" wx:if="{{tags_public.length}}">
                  <view class="dc-item" wx:for="{{tags_public}}" wx:for-item="t" wx:key="key">
                    <view class="dc-item-top">
                      <view style="min-width:0;">
                        <text class="dc-item-title">{{t.tag}}</text>
                        <text class="dc-item-meta">题目 {{t.count}} · 已做 {{t.answered}} · 正确率 {{t.accuracy}}% · 错题次数 {{t.mistakes_times}} · 收藏 {{t.favorites}}</text>
                      </view>
                      <view class="dc-item-actions">
                        <view class="dc-mini-btn primary" bindtap="onGoTagCenterPublic" data-tag="{{t.tag}}" aria-role="button"><text>按标签练习</text></view>
                        <view class="dc-mini-btn" bindtap="onGoTagsCenter" aria-role="button"><text>去中心</text></view>
                      </view>
                    </view>
                    <view class="dc-bars" aria-hidden="true">
                      <view class="dc-bar">
                        <view class="dc-bar-inner" style="width: {{t.bar_count_pct}}%;"></view>
                      </view>
                      <view class="dc-bar secondary">
                        <view class="dc-bar-inner" style="width: {{t.accuracy}}%;"></view>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="dc-empty" wx:else>你还没有在公共题库给题目打标签。</view>
              </view>

              <view class="dc-span-6">
                <view class="dc-card-head">
                  <view style="min-width:0;">
                    <text class="dc-h3">个人题库标签</text>
                  </view>
                </view>
                <view class="dc-list" wx:if="{{tags_banks.length}}">
                  <view class="dc-item" wx:for="{{tags_banks}}" wx:for-item="t" wx:key="key">
                    <view class="dc-item-top">
                      <view style="min-width:0;">
                        <text class="dc-item-title">{{t.tag}}</text>
                        <text class="dc-item-meta">题目 {{t.count}} · 已做 {{t.answered}} · 正确率 {{t.accuracy}}% · 错题次数 {{t.mistakes_times}} · 收藏 {{t.favorites}}</text>
                      </view>
                      <view class="dc-item-actions">
                        <view class="dc-mini-btn primary" bindtap="onGoTagCenterBanks" data-tag="{{t.tag}}" aria-role="button"><text>去中心下钻</text></view>
                      </view>
                    </view>
                    <view class="dc-bars" aria-hidden="true">
                      <view class="dc-bar">
                        <view class="dc-bar-inner" style="width: {{t.bar_count_pct}}%;"></view>
                      </view>
                      <view class="dc-bar secondary">
                        <view class="dc-bar-inner" style="width: {{t.accuracy}}%;"></view>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="dc-empty" wx:else>你还没有在个人题库给题目打标签。</view>
              </view>
            </view>
          </view>
          </block>
        </view>
        </block>

        <view class="msg error" wx:if="{{errorMsg}}">
          <text>{{errorMsg}}</text>
        </view>
        <view class="loading" wx:if="{{loading}}">
          <text>正在加载数据...</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
