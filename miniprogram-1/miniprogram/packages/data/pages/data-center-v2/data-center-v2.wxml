<view class="page-root {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="数据" back="{{false}}" color="var(--app-nav-fg)" background="var(--app-nav-bg)">
    <view slot="left" class="nav-left">
      <view class="icon-btn" bindtap="onHamburgerTap" aria-role="button" aria-label="打开侧边栏">
        <view class="icon-hamburger"></view>
      </view>
      <view class="icon-btn" bindtap="onCycleThemeModeTap" aria-role="button" aria-label="切换主题模式">
        <image class="icon" src="{{isDarkMode ? '/images/icons/moon.svg' : '/images/icons/sun.svg'}}" mode="aspectFit"></image>
        <view class="theme-auto" wx:if="{{themeMode === 'system'}}">
          <text>A</text>
        </view>
      </view>
    </view>
  </navigation-bar>

  <v2-drawer
    open="{{drawerOpen}}"
    themeStyle="{{themeStyle}}"
    activeKey="data"
    bind:close="onDrawerClose"
    bind:navigate="onDrawerNavigate"
    bind:selectstyle="onDrawerSelectStyle"
  />

  <view class="page-container">
    <scroll-view
      class="content-area"
      scroll-y
      bounces="{{false}}"
      refresher-enabled="{{true}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <view class="container">
        <view id="dcTop"></view>
        <view class="dc-hero" aria-label="数据中心 · {{tabTitle}}">
          <view class="dc-hero-main">
            <view class="dc-hero-title" style="min-width:0;">
              <text class="dc-h1">数据中心 · {{tabTitle}}</text>
            </view>

            <view class="dc-hero-actions" aria-label="时间窗口与操作">
              <view class="dc-window" aria-label="时间窗口">
                <view class="dc-window-tab {{days===7 ? 'active' : ''}}" bindtap="onDaysTap" data-days="7"><text>7天</text></view>
                <view class="dc-window-tab {{days===30 ? 'active' : ''}}" bindtap="onDaysTap" data-days="30"><text>30天</text></view>
                <view class="dc-window-tab {{days===90 ? 'active' : ''}}" bindtap="onDaysTap" data-days="90"><text>90天</text></view>
              </view>
            </view>
          </view>

          <view class="dc-hero-kpis" style="display:flex;flex-direction:column;gap:10rpx;" aria-label="关键指标">
            <block wx:if="{{tab==='global'}}">
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">已做题</text><text class="v mono" style="flex-shrink:0;">{{all_summary.answered || 0}}</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">正确率</text><text class="v mono" style="flex-shrink:0;">{{all_summary.accuracy || 0}}%</text></view>
              </view>
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">完成度</text><text class="v mono" style="flex-shrink:0;">{{all_summary.completion || 0}}%</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">健康分</text><text class="v mono" style="flex-shrink:0;">{{health_score || 0}}</text></view>
              </view>
            </block>
            <block wx:elif="{{tab==='banks'}}">
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">个人题库</text><text class="v mono" style="flex-shrink:0;">{{bank_summary.bank_total || 0}}</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">公共规模</text><text class="v mono" style="flex-shrink:0;">{{total_questions || 0}}</text></view>
              </view>
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">近窗已做</text><text class="v mono" style="flex-shrink:0;">{{window_answered || 0}}</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">正确率</text><text class="v mono" style="flex-shrink:0;">{{all_summary.accuracy || 0}}%</text></view>
              </view>
            </block>
            <block wx:elif="{{tab==='mistakes'}}">
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">错题数</text><text class="v mono" style="flex-shrink:0;">{{all_summary.mistakes || 0}}</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">错题次数</text><text class="v mono" style="flex-shrink:0;">{{all_summary.mistakes_times || 0}}</text></view>
              </view>
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">近窗新增</text><text class="v mono" style="flex-shrink:0;">{{mistakes_new || 0}}</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">健康分</text><text class="v mono" style="flex-shrink:0;">{{health_score || 0}}</text></view>
              </view>
            </block>
            <block wx:elif="{{tab==='favorites'}}">
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">收藏数</text><text class="v mono" style="flex-shrink:0;">{{all_summary.favorites || 0}}</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">近窗新增</text><text class="v mono" style="flex-shrink:0;">{{favorites_new || 0}}</text></view>
              </view>
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">收藏密度</text><text class="v mono" style="flex-shrink:0;">{{favorites_density || 0}}%</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">健康分</text><text class="v mono" style="flex-shrink:0;">{{health_score || 0}}</text></view>
              </view>
            </block>
            <block wx:else>
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">标签总数</text><text class="v mono" style="flex-shrink:0;">{{tags_kpis.all_tag_count || 0}}</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">已打标签题</text><text class="v mono" style="flex-shrink:0;">{{tags_kpis.all_tagged_questions || 0}}</text></view>
              </view>
              <view style="display:flex;gap:10rpx;">
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">覆盖率</text><text class="v mono" style="flex-shrink:0;">{{tags_kpis.tagged_answered_coverage || 0}}%</text></view>
                <view class="dc-kpi-pill" style="flex:1;height:100rpx;display:flex;align-items:center;justify-content:space-between;overflow:hidden;"><text class="k" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">健康分</text><text class="v mono" style="flex-shrink:0;">{{health_score || 0}}</text></view>
              </view>
            </block>
          </view>
        </view>

        <view class="dc-basebar" aria-label="数据中心导航">
          <scroll-view class="dc-tabs" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="dc-tabs-inner">
              <view class="dc-tab {{tab==='global' ? 'active' : ''}}" bindtap="onTabTap" data-tab="global"><text>全局</text></view>
              <view class="dc-tab {{tab==='banks' ? 'active' : ''}}" bindtap="onTabTap" data-tab="banks"><text>题库</text></view>
              <view class="dc-tab {{tab==='mistakes' ? 'active' : ''}}" bindtap="onTabTap" data-tab="mistakes"><text>错题</text></view>
              <view class="dc-tab {{tab==='favorites' ? 'active' : ''}}" bindtap="onTabTap" data-tab="favorites"><text>收藏</text></view>
              <view class="dc-tab {{tab==='tags' ? 'active' : ''}}" bindtap="onTabTap" data-tab="tags"><text>标签</text></view>
            </view>
          </scroll-view>
        </view>

        <block wx:if="{{tab==='global'}}">
        <view class="dc-bento" aria-label="全局数据看板">
          <view class="dc-card dc-span-12" aria-label="趋势总览">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">趋势总览（公共 + 个人）</text>
              </view>
              <view class="dc-ai-badge" title="最近活跃">
                <text>最近活跃：{{last_activity_16}}</text>
              </view>
            </view>
            <view class="dc-chart lg" aria-label="趋势图（可缩放）">
              <ec-canvas id="dcTrendDetailChart" canvas-id="dcTrendDetailChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-12 dc-lazy-card" wx:if="{{lazyStage < 2}}" id="dcLazyStage2Trigger" aria-label="继续下滑加载更多">
            <text class="dc-lazy-title">继续下滑加载更多</text>
            <text class="dc-lazy-sub">下方卡片与图表会在滚动时渲染</text>
          </view>

          <block wx:if="{{lazyStage >= 2}}">
          <view class="dc-card dc-span-8" aria-label="学习闭环地图">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">学习闭环地图</text>
              </view>
            </view>
            <view class="dc-chart md dc-tall" aria-label="学习闭环地图（桑基图）">
              <ec-canvas id="dcGlobalLoopChart" canvas-id="dcGlobalLoopChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-4" aria-label="系统健康">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">系统健康</text>
              </view>
            </view>
            <view class="dc-chart md dc-tall" aria-label="学习健康分仪表盘">
              <ec-canvas id="dcHealthGaugeChart" canvas-id="dcHealthGaugeChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-8" aria-label="日历热力图">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">日历热力图</text>
              </view>
            </view>
            <view class="dc-chart lg" aria-label="日历热力图（每日已做题）">
              <ec-canvas id="dcCalendarChart" canvas-id="dcCalendarChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-4" aria-label="活跃热力">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">活跃热力</text>
              </view>
            </view>
            <view class="dc-chart lg" aria-label="活跃热力图">
              <ec-canvas id="dcHeatmapChart" canvas-id="dcHeatmapChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-4" aria-label="学习时段">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">学习时段</text>
              </view>
            </view>
            <view class="dc-chart md" aria-label="小时分布">
              <ec-canvas id="dcHourlyChart" canvas-id="dcHourlyChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-4" aria-label="星期分布">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">星期分布</text>
              </view>
            </view>
            <view class="dc-chart md" aria-label="星期分布">
              <ec-canvas id="dcWeekdayChart" canvas-id="dcWeekdayChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-4" aria-label="资产新增">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">资产新增</text>
              </view>
            </view>
            <view class="dc-chart md" aria-label="错题与收藏新增趋势">
              <ec-canvas id="dcAssetTrendChart" canvas-id="dcAssetTrendChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-6" aria-label="能力画像">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">能力画像</text>
              </view>
            </view>
            <view class="dc-chart md" aria-label="能力雷达图">
              <ec-canvas id="dcRadarChart" canvas-id="dcRadarChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-6" aria-label="Top 维度">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">Top 维度</text>
              </view>
            </view>
            <view class="dc-chart md" aria-label="Top 维度图">
              <ec-canvas id="dcTopMixChart" canvas-id="dcTopMixChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-6" aria-label="错题结构（题型）">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">错题结构：题型</text>
              </view>
            </view>
            <view class="dc-chart md" aria-label="错题题型结构">
              <ec-canvas id="dcTypeDistChart" canvas-id="dcTypeDistChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-6" aria-label="错题结构（难度）">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">错题结构：难度</text>
              </view>
            </view>
            <view class="dc-chart md" aria-label="错题难度结构">
              <ec-canvas id="dcDifficultyDistChart" canvas-id="dcDifficultyDistChart" ec="{{ecLazy}}" class="dc-echart"></ec-canvas>
            </view>
          </view>

          <view class="dc-card dc-span-6" aria-label="全局洞察">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">全局洞察</text>
              </view>
            </view>
            <view class="dc-list" wx:if="{{global_insights.length}}">
              <view class="dc-item" wx:for="{{global_insights}}" wx:for-item="it" wx:key="key">
                <view class="dc-item-top">
                  <view style="min-width:0;">
                    <text class="dc-item-title">{{it.title}}</text>
                    <text class="dc-item-meta">{{it.value}}</text>
                    <text class="dc-item-meta muted">{{it.hint}}</text>
                  </view>
                </view>
              </view>
            </view>
            <view class="dc-empty" wx:else>暂时还无法生成洞察（可能是答题数据不足）。</view>
            <view class="dc-item-actions" style="margin-top:20rpx;">
              <view class="dc-mini-btn" bindtap="onTabTap" data-tab="banks" aria-role="button"><text>题库视角</text></view>
              <view class="dc-mini-btn" bindtap="onTabTap" data-tab="mistakes" aria-role="button"><text>错题视角</text></view>
              <view class="dc-mini-btn" bindtap="onTabTap" data-tab="favorites" aria-role="button"><text>收藏视角</text></view>
            </view>
          </view>

          <view class="dc-card dc-span-6" aria-label="下一步行动">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">下一步行动</text>
              </view>
            </view>

            <view class="dc-list" wx:if="{{next_actions.length}}">
              <view class="dc-item" wx:for="{{next_actions}}" wx:for-item="a" wx:key="key">
                <view class="dc-item-top">
                  <view style="min-width:0;">
                    <text class="dc-item-title">{{a.title}}</text>
                    <text class="dc-item-meta">{{a.reason}}</text>
                    <text class="dc-item-meta muted">{{a.metrics}}</text>
                  </view>
                  <view class="dc-item-actions">
                    <view class="dc-mini-btn primary" bindtap="onGoQuizPublicMistakes" data-subject="{{a.subject}}" data-q-type="{{a.q_type}}" aria-role="button"><text>刷错题</text></view>
                    <view class="dc-mini-btn" bindtap="onGoQuizPublicAll" data-subject="{{a.subject}}" data-q-type="{{a.q_type}}" aria-role="button"><text>重练</text></view>
                  </view>
                </view>
              </view>
            </view>
            <view class="dc-empty" wx:else>先做几道题再来看，这里会给出更有指导意义的建议。</view>

            <view class="dc-card-head" style="margin-top:24rpx;">
              <view style="min-width:0;">
                <text class="dc-h3">薄弱点（科目 × 题型）</text>
              </view>
            </view>
            <view class="dc-list" wx:if="{{weakness_rows.length}}">
              <view class="dc-item" wx:for="{{weakness_rows}}" wx:for-item="w" wx:key="key">
                <view class="dc-item-top">
                  <view style="min-width:0;">
                    <text class="dc-item-title">{{w.subject}} · {{w.q_type}}</text>
                    <text class="dc-item-meta">正确率 {{w.accuracy}}% · 已做 {{w.answered}} · 错题 {{w.mistakes}}</text>
                  </view>
                  <view class="dc-item-actions">
                    <view class="dc-mini-btn primary" bindtap="onGoQuizPublicMistakes" data-subject="{{w.subject}}" data-q-type="{{w.q_type}}" aria-role="button"><text>刷错题</text></view>
                  </view>
                </view>
                <view class="dc-bars" aria-hidden="true">
                  <view class="dc-bar secondary">
                    <view class="dc-bar-inner" style="width: {{w.accuracy}}%;"></view>
                  </view>
                </view>
              </view>
            </view>
            <view class="dc-empty" wx:else>暂无可用薄弱点排行（可能是做题不足或数据为空）。</view>
          </view>

          <view class="dc-card dc-span-12" aria-label="最近错题与收藏">
            <view class="dc-card-head">
              <view style="min-width:0;">
                <text class="dc-h2">最近错题与收藏</text>
              </view>
            </view>

            <view class="dc-bento" aria-label="最近记录">
              <view class="dc-span-6">
                <view class="dc-card-head">
                  <view style="min-width:0;">
                    <text class="dc-h3">公共题库 · 最近错题</text>
                  </view>
                  <view class="dc-item-actions">
                    <view class="dc-mini-btn" bindtap="onGoMistakesCenter" aria-role="button"><text>去错题中心</text></view>
                  </view>
                </view>
                <view class="dc-list" wx:if="{{recent_mistakes.length}}">
                  <view class="dc-item" wx:for="{{recent_mistakes}}" wx:for-item="m" wx:key="key">
                    <view class="dc-item-top">
                      <view style="min-width:0;">
                        <text class="dc-item-title">{{m.subject}} · {{m.q_type}} · 难度{{m.difficulty}}</text>
                        <text class="dc-item-meta">{{m.snippet}}</text>
                      </view>
                      <view class="dc-item-actions">
                        <view class="dc-mini-btn primary" bindtap="onGoQuizPublicMistakes" data-subject="{{m.subject}}" data-q-type="{{m.q_type}}" aria-role="button"><text>刷同类错题</text></view>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="dc-empty" wx:else>暂无错题记录。</view>
              </view>

              <view class="dc-span-6">
                <view class="dc-card-head">
