# Public credentials for a loopback-only local demo. Never use in production.
COMPOSE_PROJECT_NAME=ti-local-demo
TI_IMAGE=ti-local-demo:latest
TI_IMAGE_PULL_POLICY=never
WEB_BIND=127.0.0.1
WEB_PORT=8000
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=studypass
POSTGRES_DB=ti_demo
SECRET_KEY=local-demo-secret-not-for-production
BACKUP_CREDENTIAL_SECRET=local-demo-backup-not-for-production
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=DevPass123!
DEFAULT_ADMIN_EMAIL=admin@example.dev
DEFAULT_ADMIN_PHONE=13900000001
MAIL_ENABLED=false
SMS_ENABLED=false
