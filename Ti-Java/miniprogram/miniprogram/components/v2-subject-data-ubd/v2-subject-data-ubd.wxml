<view class="ubd-shell {{statsDays===90 ? 'days-90' : ''}}" aria-label="题库数据面板">
  <view class="ubd-hero" aria-label="题库数据概览">
    <view class="ubd-hero-left">
      <text class="ubd-h1">{{subjectName || '题库'}}</text>
      <text class="ubd-hero-sub">
        {{dataSubTab==='mistakes'
          ? '错题视角：把“风险、优先级与回收路径”放到一张图里。'
          : (dataSubTab==='favorites'
            ? '收藏视角：把“结构、节奏与复习质量”放到一张图里。'
            : '全局视角：把“覆盖、正确与节奏”放到一张图里。')}}
      </text>
    </view>
    <view class="ubd-hero-pills" aria-label="题库概览指标">
      <view class="ubd-pill">
        <text class="k">总题</text>
        <text class="v mono">{{heroTotalText}}</text>
      </view>
      <view class="ubd-pill">
        <text class="k">收藏</text>
        <text class="v mono">{{heroFavText}}</text>
      </view>
      <view class="ubd-pill">
        <text class="k">错题</text>
        <text class="v mono">{{heroMistakeText}}</text>
      </view>
    </view>
  </view>

  <view
    class="ubd-subnav"
    style="top: {{stickyTop}};"
    role="navigation"
    aria-label="数据子页导航"
  >
    <view class="ubd-tabs" role="tablist" aria-label="全局/错题/收藏">
      <view
        class="ubd-tab {{dataSubTab==='global' ? 'active' : ''}}"
        bindtap="onSubTabTap"
        data-subtab="global"
        role="tab"
        aria-selected="{{dataSubTab==='global'}}"
      >
        <text>全局</text>
      </view>
      <view
        class="ubd-tab {{dataSubTab==='mistakes' ? 'active' : ''}}"
        bindtap="onSubTabTap"
        data-subtab="mistakes"
        role="tab"
        aria-selected="{{dataSubTab==='mistakes'}}"
      >
        <text>错题</text>
      </view>
      <view
        class="ubd-tab {{dataSubTab==='favorites' ? 'active' : ''}}"
        bindtap="onSubTabTap"
        data-subtab="favorites"
        role="tab"
        aria-selected="{{dataSubTab==='favorites'}}"
      >
        <text>收藏</text>
      </view>
    </view>

    <view class="ubd-subnav-right" aria-label="时间窗口">
      <view class="ubd-days" role="tablist" aria-label="时间窗口">
        <view class="ubd-day {{statsDays===7 ? 'active' : ''}}" bindtap="onDaysTap" data-days="7" role="tab">
          <text>7天</text>
        </view>
        <view class="ubd-day {{statsDays===14 ? 'active' : ''}}" bindtap="onDaysTap" data-days="14" role="tab">
          <text>14天</text>
        </view>
        <view class="ubd-day {{statsDays===30 ? 'active' : ''}}" bindtap="onDaysTap" data-days="30" role="tab">
          <text>30天</text>
        </view>
        <view class="ubd-day {{statsDays===90 ? 'active' : ''}}" bindtap="onDaysTap" data-days="90" role="tab">
          <text>90天</text>
        </view>
      </view>
    </view>
  </view>

  <view class="ubd-grid" aria-label="数据内容">
    <view class="ubd-card ubd-kpis span-12" aria-label="关键指标">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">{{dataSubTab==='mistakes' ? '错题总览' : (dataSubTab==='favorites' ? '收藏总览' : '战略总览')}}</text>
          <text class="ubd-sub">{{headlineText}}</text>
        </view>
        <view class="ubd-badge">
          <text>{{updatedAtText}}</text>
        </view>
      </view>

      <view class="ubd-kpi-grid" aria-label="KPI列表">
        <view class="ubd-kpi" wx:for="{{kpiItems}}" wx:key="key">
          <text class="k">{{item.label}}</text>
          <text class="v mono">{{item.value}}</text>
          <text class="m">{{item.meta}}</text>
        </view>
        <view class="ubd-kpi ubd-kpi-action" wx:if="{{dataSubTab==='mistakes' || dataSubTab==='favorites'}}">
          <text class="k">快速入口</text>
          <view class="v">
            <view class="ubd-cta" bindtap="onQuickStartTap" aria-role="button" aria-label="快速入口">
              <text>{{dataSubTab==='mistakes' ? '去错题练习' : '去收藏练习'}}</text>
            </view>
          </view>
          <text class="m">{{dataSubTab==='mistakes' ? '按错题集刷题' : '按收藏集刷题'}}</text>
        </view>
      </view>
    </view>

    <view class="ubd-card span-7" aria-label="优先级矩阵" wx:if="{{dataSubTab==='mistakes'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">优先级矩阵</text>
          <text class="ubd-sub">横轴=错题次数；纵轴=距上次错题的天数（越久越需要回收）。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas
          id="ubdMistakeMatrixChart"
          canvas-id="ubdMistakeMatrixChart"
          ec="{{ecLazy}}"
          class="ubd-echart"
        ></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-5" aria-label="Top错题" wx:if="{{dataSubTab==='mistakes'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">Top 错题</text>
          <text class="ubd-sub">按错题次数排序，优先解决重复犯错。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas
          id="ubdMistakeTopChart"
          canvas-id="ubdMistakeTopChart"
          ec="{{ecLazy}}"
          class="ubd-echart"
        ></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-12" aria-label="收藏新增趋势" wx:if="{{dataSubTab==='favorites'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">收藏新增趋势</text>
          <text class="ubd-sub">按天统计新增收藏数量（基于收藏创建时间）。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas
          id="ubdFavAddedChart"
          canvas-id="ubdFavAddedChart"
          ec="{{ecLazy}}"
          class="ubd-echart"
        ></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-12" aria-label="收藏结构" wx:if="{{dataSubTab==='favorites'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">收藏结构</text>
          <text class="ubd-sub">题型分布（占比）+ 难度拆解（如可用）。</text>
        </view>
      </view>
      <view class="ubd-split">
        <view class="ubd-chart ubd-chart-tall">
          <ec-canvas id="ubdFavTypePieChart" canvas-id="ubdFavTypePieChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
        </view>
        <view class="ubd-chart ubd-chart-tall">
          <ec-canvas id="ubdFavDiffChart" canvas-id="ubdFavDiffChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
        </view>
      </view>
    </view>

    <view class="ubd-card span-7" aria-label="学习热力" wx:if="{{dataSubTab==='global'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">学习热力</text>
          <text class="ubd-sub">日历视角观察投入强度与节奏（按天作答）。</text>
        </view>
      </view>
      <view class="ubd-chart ubd-chart-calendar">
        <ec-canvas id="ubdCalendarChart" canvas-id="ubdCalendarChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-5" aria-label="掌握指数" wx:if="{{dataSubTab==='global'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">掌握指数</text>
          <text class="ubd-sub">综合正确率与覆盖率（仅用于辅助判断）。</text>
        </view>
      </view>

      <view class="ubd-chart ubd-chart-tall">
        <ec-canvas id="ubdGaugeChart" canvas-id="ubdGaugeChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>

      <view class="ubd-metrics" aria-label="指标拆解">
        <view class="ubd-metric">
          <text class="k">稳定度</text>
          <view class="bar"><view class="bar-i" style="width: {{metricStability}}%;"></view></view>
          <text class="v mono">{{metricStabilityText}}</text>
        </view>
        <view class="ubd-metric">
          <text class="k">效率</text>
          <view class="bar"><view class="bar-i" style="width: {{metricPace}}%;"></view></view>
          <text class="v mono">{{metricPaceText}}</text>
        </view>
      </view>
    </view>

    <view class="ubd-card span-7" aria-label="趋势分析" wx:if="{{dataSubTab==='global'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">趋势分析</text>
          <text class="ubd-sub">作答量（柱）+ 正确率（线）按天变化。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas id="ubdTrendChart" canvas-id="ubdTrendChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-12" aria-label="错题复习趋势" wx:elif="{{dataSubTab==='mistakes'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">错题复习趋势</text>
          <text class="ubd-sub">按天统计：复习量（柱）+ 复习正确率（线）。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas id="ubdMisTrendChart" canvas-id="ubdMisTrendChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-12" aria-label="收藏复习趋势" wx:else>
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">收藏复习趋势</text>
          <text class="ubd-sub">按天统计：复习量（柱）+ 复习正确率（线）。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas
          id="ubdFavReviewTrendChart"
          canvas-id="ubdFavReviewTrendChart"
          ec="{{ecLazy}}"
          class="ubd-echart"
        ></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-5" aria-label="结构拆解" wx:if="{{dataSubTab==='global'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">结构拆解</text>
          <text class="ubd-sub">题型层面：正确/错误堆叠，附覆盖率线。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas id="ubdTypeChart" canvas-id="ubdTypeChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-6" aria-label="学习漏斗" wx:if="{{dataSubTab==='global'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">学习漏斗</text>
          <text class="ubd-sub">从“题库总量”到“稳定掌握”的路径（以最新作答为准）。</text>
        </view>
      </view>
      <view class="ubd-chart ubd-chart-tall">
        <ec-canvas id="ubdFunnelChart" canvas-id="ubdFunnelChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-6" aria-label="风险雷达" wx:if="{{dataSubTab==='global'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">风险雷达</text>
          <text class="ubd-sub">优先关注：覆盖低 + 错题集中或正确率低的题型。</text>
        </view>
      </view>
      <view class="ubd-chart ubd-chart-tall">
        <ec-canvas id="ubdRiskRadarChart" canvas-id="ubdRiskRadarChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-12" aria-label="错题结构" wx:if="{{dataSubTab==='mistakes'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">错题结构</text>
          <text class="ubd-sub">题型分布（占比）+ 难度拆解（如可用）。</text>
        </view>
      </view>
      <view class="ubd-split">
        <view class="ubd-chart ubd-chart-tall">
          <ec-canvas id="ubdMisTypePieChart" canvas-id="ubdMisTypePieChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
        </view>
        <view class="ubd-chart ubd-chart-tall">
          <ec-canvas id="ubdMisDiffChart" canvas-id="ubdMisDiffChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
        </view>
      </view>
    </view>

    <view class="ubd-card span-12" aria-label="题型画像" wx:if="{{dataSubTab==='global'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">题型画像</text>
          <text class="ubd-sub">覆盖率 = 已做 / 总题；正确率 = 正确 / 已做。附收藏/错题分布。</text>
        </view>
      </view>

      <scroll-view scroll-x class="ubd-table-wrap" aria-label="题型画像表格">
        <view class="ubd-table">
          <view class="ubd-tr ubd-th">
            <text class="ubd-td col-type">题型</text>
            <text class="ubd-td col-count">已做/总题</text>
            <text class="ubd-td col-acc">正确率</text>
            <text class="ubd-td col-comp">覆盖率</text>
            <text class="ubd-td col-fav">收藏</text>
            <text class="ubd-td col-mis">错题</text>
          </view>

          <view class="ubd-tr" wx:if="{{!typeTableRows.length}}">
            <text class="ubd-td ubd-muted">暂无数据</text>
          </view>

          <view class="ubd-tr" wx:for="{{typeTableRows}}" wx:key="q_type">
            <text class="ubd-td col-type">{{item.q_type}}</text>
            <text class="ubd-td col-count mono">{{item.answered}} / {{item.total}}</text>
            <text class="ubd-td col-acc mono">{{item.accuracyText}}</text>
            <text class="ubd-td col-comp mono">{{item.completionText}}</text>
            <text class="ubd-td col-fav mono">{{item.favorites}}</text>
            <text class="ubd-td col-mis mono">{{item.mistakes}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="ubd-card span-12" aria-label="难度拆解" wx:if="{{dataSubTab==='global' && statsHasDifficulty}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">难度拆解</text>
          <text class="ubd-sub">按难度观察覆盖与正确率（题库未配置难度时自动隐藏）。</text>
        </view>
      </view>
      <view class="ubd-chart">
        <ec-canvas id="ubdDiffChart" canvas-id="ubdDiffChart" ec="{{ecLazy}}" class="ubd-echart"></ec-canvas>
      </view>
    </view>

    <view class="ubd-card span-12" aria-label="错题清单" wx:if="{{dataSubTab==='mistakes'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">错题清单</text>
          <text class="ubd-sub">包含错题次数与最近错题时间（仅展示前50条）</text>
        </view>
      </view>
      <scroll-view scroll-x class="ubd-table-wrap" aria-label="错题清单表格">
        <view class="ubd-table ubd-qtable ubd-qtable-mis">
          <view class="ubd-tr ubd-th ubd-qtr">
            <text class="ubd-td col-content">题目</text>
            <text class="ubd-td col-type">题型</text>
            <text class="ubd-td col-diff">难度</text>
            <text class="ubd-td col-wc">错题次数</text>
            <text class="ubd-td col-lastwrong">最近错题</text>
            <text class="ubd-td col-lastans">最近作答</text>
            <text class="ubd-td col-res">上次结果</text>
          </view>

          <view class="ubd-tr ubd-qtr" wx:if="{{!mistakeRows.length}}">
            <text class="ubd-td ubd-muted">{{statsLoading ? '加载中…' : (statsError ? '加载失败' : '暂无数据')}}</text>
          </view>

          <view
            class="ubd-tr ubd-qtr"
            wx:for="{{mistakeRows}}"
            wx:key="id"
            bindtap="onQuestionTap"
            data-id="{{item.id}}"
          >
            <text class="ubd-td col-content">{{item.content}}</text>
            <text class="ubd-td col-type">{{item.q_type}}</text>
            <text class="ubd-td col-diff mono">{{item.difficultyText}}</text>
            <text class="ubd-td col-wc mono">{{item.col1}}</text>
            <text class="ubd-td col-lastwrong mono">{{item.col2}}</text>
            <text class="ubd-td col-lastans mono">{{item.col3}}</text>
            <text class="ubd-td col-res mono res-{{item.resultClass}}">{{item.resultText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="ubd-card span-12" aria-label="收藏清单" wx:if="{{dataSubTab==='favorites'}}">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">收藏清单</text>
          <text class="ubd-sub">按收藏时间倒序（仅展示前50条），附最近作答与结果。</text>
        </view>
      </view>
      <scroll-view scroll-x class="ubd-table-wrap" aria-label="收藏清单表格">
        <view class="ubd-table ubd-qtable ubd-qtable-fav">
          <view class="ubd-tr ubd-th ubd-qtr">
            <text class="ubd-td col-content">题目</text>
            <text class="ubd-td col-type">题型</text>
            <text class="ubd-td col-diff">难度</text>
            <text class="ubd-td col-favat">收藏时间</text>
            <text class="ubd-td col-lastans">最近作答</text>
            <text class="ubd-td col-res">上次结果</text>
          </view>

          <view class="ubd-tr ubd-qtr" wx:if="{{!favoriteRows.length}}">
            <text class="ubd-td ubd-muted">{{statsLoading ? '加载中…' : (statsError ? '加载失败' : '暂无数据')}}</text>
          </view>

          <view
            class="ubd-tr ubd-qtr"
            wx:for="{{favoriteRows}}"
            wx:key="id"
            bindtap="onQuestionTap"
            data-id="{{item.id}}"
          >
            <text class="ubd-td col-content">{{item.content}}</text>
            <text class="ubd-td col-type">{{item.q_type}}</text>
            <text class="ubd-td col-diff mono">{{item.difficultyText}}</text>
            <text class="ubd-td col-favat mono">{{item.col1}}</text>
            <text class="ubd-td col-lastans mono">{{item.col2}}</text>
            <text class="ubd-td col-res mono res-{{item.resultClass}}">{{item.resultText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="ubd-card span-12" aria-label="行动建议">
      <view class="ubd-card-head">
        <view class="ubd-card-head-left">
          <text class="ubd-title">{{dataSubTab==='mistakes' ? '纠错建议' : (dataSubTab==='favorites' ? '收藏建议' : '行动建议')}}</text>
          <text class="ubd-sub">{{dataSubTab==='mistakes' ? '基于错题集的覆盖/正确/结构拆解生成' : (dataSubTab==='favorites' ? '基于收藏集的覆盖/正确/结构拆解生成' : '结合覆盖率/正确率/错题表现给出下一步方向')}}</text>
        </view>
      </view>

      <view class="ubd-advice" wx:if="{{statsAdvice.length}}">
        <view class="ubd-advice-item" wx:for="{{statsAdvice}}" wx:key="title">
          <text class="t">{{item.title || '建议'}}</text>
          <text class="c">{{item.content || ''}}</text>
        </view>
      </view>
      <view class="ubd-empty" wx:else>
        <text>{{statsLoading ? '加载中…' : (statsError ? '加载失败' : '暂无建议')}}</text>
      </view>
    </view>
  </view>
</view>
