<!-- quiz-settlement.wxml - 刷题/背题/加强 结算页 -->
<view class="page-root {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="结算" back="{{true}}" color="var(--app-nav-fg)" background="var(--app-nav-bg)" />

  <view class="page-container">
    <scroll-view class="content-area" scroll-y bounces="{{false}}">
      <view class="container">
        <view class="loading" wx:if="{{loading}}">
          <text>加载中...</text>
        </view>

        <view class="error" wx:if="{{!loading && errorText}}">
          <text>{{errorText}}</text>
        </view>

        <view wx:if="{{!loading && !errorText && payload}}" class="stack">
          <view class="card summary" aria-label="本次结算">
            <view class="summary-hd">
              <view class="summary-main">
                <text class="summary-title">{{payload.displayName}}</text>

                <view class="chips" wx:if="{{subChips && subChips.length}}">
                  <view
                    class="chip {{index === 0 ? 'chip--accent' : ''}}"
                    wx:for="{{subChips}}"
                    wx:for-item="item"
                    wx:for-index="index"
                    wx:key="*this"
                  >
                    <text>{{item}}</text>
                  </view>
                </view>
              </view>

              <view class="badge"><text>本次结算</text></view>
            </view>

            <view class="stats" aria-label="成绩概览">
              <view class="stat stat--accent">
                <text class="k">正确率</text>
                <text class="v num">{{accuracy}}%</text>
              </view>
              <view class="stat">
                <text class="k">用时</text>
                <text class="v num {{usedTextClass}}">{{usedText}}</text>
              </view>
              <view class="stat stat--success">
                <text class="k">答对</text>
                <text class="v num">{{correct}}</text>
              </view>
              <view class="stat stat--danger">
                <text class="k">答错</text>
                <text class="v num">{{wrong}}</text>
              </view>
            </view>

            <view class="progress" aria-label="答题进度">
              <view class="progress-row">
                <text class="k">已答</text>
                <text class="v num">{{answered}} / {{total}}</text>
              </view>
              <view class="track">
                <view class="fill" style="width: {{answeredPercent}}%;"></view>
              </view>
            </view>

            <view class="note note--warn" wx:if="{{hasWrong}}">
              <text>本次错题 {{wrong}} 道，可直接进入错题加强训练。</text>
            </view>
            <view class="note note--ok" wx:else>
              <text>本次没有错题，继续保持。</text>
            </view>
          </view>

          <view class="card actions" aria-label="快捷操作">
            <button class="btn btn-primary" bindtap="onTapContinue">回到题目</button>

            <view class="action-grid">
              <button class="btn btn-tile" bindtap="onTapReinforceWrong" disabled="{{!hasWrong}}">
                <text class="t">错题加强</text>
                <text class="d">只练本次错题</text>
              </button>

              <button class="btn btn-tile" bindtap="onTapMistakesCenter">
                <text class="t">错题中心</text>
                <text class="d">查看错题汇总</text>
              </button>

              <button class="btn btn-tile" bindtap="onTapExam">
                <text class="t">去考试</text>
                <text class="d">模拟考试模式</text>
              </button>

              <button class="btn btn-tile" open-type="share">
                <text class="t">分享</text>
                <text class="d">分享本次数据</text>
              </button>
            </view>

            <button class="btn btn-link" bindtap="onTapExit">返回首页</button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
