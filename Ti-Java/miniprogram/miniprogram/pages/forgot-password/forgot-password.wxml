<!--忘记密码页面-->
<view class="page-root {{themeClass}} {{themeStyleClass}} {{fontStyleClass}}">
  <navigation-bar title="忘记密码" back="{{true}}" color="var(--app-nav-fg)" background="var(--app-bg)"></navigation-bar>

  <view class="page-container">
    <view class="card">
      <view class="hero">
        <text class="hero-title">重置密码</text>
        <text class="hero-sub">输入绑定的邮箱，通过验证码重置密码</text>
      </view>

      <view class="card-body">
        <view class="form-grid">
          <view class="field">
            <text class="label">邮箱</text>
            <input class="input" placeholder="请输入绑定的邮箱" placeholder-class="placeholder" value="{{email}}" bindinput="onEmailInput" />
          </view>

          <view class="field">
            <text class="label">验证码</text>
            <view class="input-row">
              <input class="input" placeholder="验证码" placeholder-class="placeholder" maxlength="8" value="{{code}}" bindinput="onCodeInput" />
              <view class="code-btn {{(codeSending || loading) ? 'disabled' : ''}}" bindtap="onSendCodeTap">
                <text>{{codeSending ? countdown + 's' : '发送'}}</text>
              </view>
            </view>
          </view>

          <view class="field">
            <text class="label">新密码</text>
            <input class="input" password placeholder="至少8位" placeholder-class="placeholder" value="{{newPassword}}" bindinput="onPasswordInput" />
          </view>
        </view>

        <button class="btn btn-primary {{loading ? 'disabled' : ''}}" bindtap="onResetTap" disabled="{{loading}}" loading="{{loading}}">
          <text>重置密码</text>
        </button>
      </view>
    </view>
  </view>
</view>
