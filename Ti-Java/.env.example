# Compose project identity. Keep this distinct from the legacy Ti project.
TI_JAVA_COMPOSE_PROJECT=ti-java-phase2

# Host bindings. Redis intentionally has no base-Compose host binding.
TI_JAVA_API_PORT=18080
TI_JAVA_POSTGRES_PORT=25432
TI_JAVA_REDIS_PORT=26379

# Phase 2 schema-only development database. This is not a production database.
TI_JAVA_DB_NAME=ti_java_phase2
TI_JAVA_DB_OWNER_USER=ti_java_fixture_owner
TI_JAVA_DB_APP_USER=ti_java_read

# These defaults point to committed, explicitly non-production example values.
# For local private values, copy each file without the .example suffix; those
# paths are ignored by Git, then update this local .env only.
TI_JAVA_DB_OWNER_PASSWORD_FILE=./infra/phase2/secrets/postgres-owner-password.example
TI_JAVA_DB_PASSWORD_FILE=./infra/phase2/secrets/ti-db-password.example
TI_JAVA_REDIS_PASSWORD_FILE=./infra/phase2/secrets/ti-redis-password.example
TI_JAVA_LOGIN_RATE_LIMIT_KEY_SECRET_FILE=./infra/phase2/secrets/ti-login-rate-limit-key-secret.example

# Phase 4A protected subject-read budgets. Local development keeps the legacy
# testing/development multiplier of 1; production configuration defaults to 100.
TI_SUBJECT_READ_RATE_LIMIT_NAMESPACE=ti-java:catalog:subject-read-rate
TI_SUBJECT_READ_REQUESTS_PER_MINUTE=60
TI_SUBJECT_READ_REQUESTS_PER_HOUR=600
TI_RATE_LIMIT_MULTIPLIER=1

# Bounded local resources and log rotation.
TI_JAVA_API_MEMORY=768m
TI_JAVA_POSTGRES_MEMORY=768m
TI_JAVA_REDIS_MEMORY=256m
TI_JAVA_LOG_MAX_SIZE=10m
TI_JAVA_LOG_MAX_FILES=3
