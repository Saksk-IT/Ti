{
  "name": "ti-java-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "generate:api": "node scripts/verify-openapi-boundaries.mjs && openapi-ts",
    "generate:api:check": "node scripts/verify-openapi-boundaries.mjs && node scripts/check-generated.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.101.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.10.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "~4.1.10",
    "vue-tsc": "~3.3.7"
  }
}
