{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ti.local/schemas/phase3/snapshot-manifest.v1.json",
  "title": "Ti Phase 3 controlled PostgreSQL snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "environment",
    "run_id",
    "scope",
    "source_side",
    "target_side",
    "created_at",
    "source_quiescence",
    "source_identity",
    "postgres",
    "payload",
    "redis_policy",
    "application_volume_policy"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "snapshot_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
    "environment": { "enum": ["local", "test"] },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$" },
    "scope": { "const": "phase3-auth-postgresql-only" },
    "source_side": { "enum": ["legacy", "java"] },
    "target_side": { "enum": ["legacy", "java"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source_quiescence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "service", "observed_at", "verified_after_dump_at", "running_container_count", "project_sha256"],
      "properties": {
        "method": { "const": "compose-service-stopped-before-pg-dump" },
        "service": { "enum": ["legacy-api", "java-api"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "verified_after_dump_at": { "type": "string", "format": "date-time" },
        "running_container_count": { "const": 0 },
        "project_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "database_sha256", "postgres_volume_sha256"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "database_sha256": { "$ref": "#/$defs/sha256" },
        "postgres_volume_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_version_num", "dump_format", "no_owner", "no_acl", "single_database"],
      "properties": {
        "server_version_num": { "const": "180004" },
        "dump_format": { "const": "custom" },
        "no_owner": { "const": true },
        "no_acl": { "const": true },
        "single_database": { "const": true }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "archive_list_sha256", "canonical_sql_sha256", "canonicalization"],
      "properties": {
        "path": { "const": "database.dump" },
        "size_bytes": { "type": "integer", "minimum": 5, "maximum": 10737418240 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "archive_list_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sql_sha256": { "$ref": "#/$defs/sha256" },
        "canonicalization": { "const": "pg-restore-sql-v2-restrict-token-static-ascii-varchar-text-array" }
      }
    },
    "redis_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copied", "target_start_state"],
      "properties": {
        "copied": { "const": false },
        "target_start_state": { "const": "fresh-empty-volume" }
      }
    },
    "application_volume_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copied", "target_start_state", "reason"],
      "properties": {
        "copied": { "const": false },
        "target_start_state": { "const": "fresh-empty-volume" },
        "reason": { "const": "phase3-auth-scope-has-no-file-payload" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
