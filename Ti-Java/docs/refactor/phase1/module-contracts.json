  "data_ownership_source": "../03-data-ownership.csv",
  "declared_business_module_count": 11,
  "declared_adapter_boundary_count": 1,
  "shared_kernel": {
    "module_id": "sharedkernel",
    "base_package": "io.saksk.ti.sharedkernel",
    "allowed_contents": [
      "typed scalar identifiers",
      "time and request correlation types",
      "stable error/result primitives",
      "outbox envelope primitives"
    ],
    "forbidden_contents": [
      "JPA entities",
      "repositories",
      "business services",
      "module-specific DTOs",
      "mutable shared aggregates"
    ]
  },
  "cross_module_rules": {
    "storage_reference": "scalar foreign IDs only",
    "transport_reference": "typed IDs, owner-defined DTOs/events, and stable shared-kernel primitives only",
    "cross_owner_foreign_id_count_from_matrix": 76,
    "physical_foreign_key_implies_java_dependency": false,
    "shared_jpa_entities": [],
    "forbidden": [
      "cross-module JPA relationships",
      "imports of another module domain, infrastructure, persistence, or entity package",
      "multi-module database transactions",
      "web adapters reading or writing repositories directly",
      "dual writes to Python and Java runtimes"
    ]
  },
  "dependency_direction": {
    "meaning": "consumer module may depend only on the listed provider public API or shared kernel; dependencies are compile-time edges and must form a DAG",
    "physical_database_foreign_keys": "inventory evidence only; they do not create Java package dependencies"
  },
  "spring_modulith_mapping": {
    "module_declaration": "each io.saksk.ti.<module> package declares @ApplicationModule with this contract's allowedDependencies",
    "public_api_exposure": "io.saksk.ti.<module>.api is an explicit @NamedInterface(\"api\"); all other subpackages remain internal",
    "public_event_exposure": "provider-owned immutable integration events live under io.saksk.ti.<module>.api.events and are part of the api named interface",
    "verification": "ApplicationModules.of(TiApplication.class).verify() plus this Phase 1 validator",
    "web_boundary": "io.saksk.ti.web is an adapter boundary and never exposes a domain entity, repository or transaction"
  },
  "dependency_adjustments": [
    {
      "edge": "catalog -> identity",
      "change_from_phase0_candidate": "added",
      "evidence": [
        "app/core/utils/subject_permissions.py:is_admin",
        "app/core/utils/subject_permissions.py:can_user_access_subject",
        "app/core/utils/subject_permissions.py:get_user_accessible_subjects",
        "03-data-ownership.csv:public_subject_users"
      ],
      "rationale": "目录可见性是 catalog 规则，但旧实现需要查询 identity 拥有的账号存在性和管理员角色；阶段 1 因此只允许 catalog 同步调用 identity 的窄只读公开 API。public_subject_users 中的 user_id 仍只是标量外部 ID。",
      "constraint": "catalog may query identity public API for actor/account state; identity must not depend on catalog and catalog must not import identity internals"
    }
  ],
  "event_dependency_constraints": {
    "consumer": "messaging",
    "event_providers": [
      "assessment",
      "learning",
      "community",
      "campus",
      "coding",
      "intelligence"
    ],
    "contract": "provider-owned immutable public event contracts only",
    "delivery": "asynchronous through a reliable publication/outbox path",
    "synchronous_reverse_calls": "forbidden",
    "identity_exception": "messaging may synchronously query the narrow identity public API to resolve an actor or recipient; identity must not call messaging in the same transaction"
  },
