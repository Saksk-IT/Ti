{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ti.local/schemas/read-compare-report.schema.json",
  "title": "Ti-Java READ_COMPARE report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "operation",
    "generated_at",
    "environment",
    "outcome",
    "operation_id",
    "fixture_id",
    "request",
    "provenance",
    "environment_fingerprints",
    "responses",
    "raw_comparison",
    "normalization",
    "side_effects",
    "differences",
    "difference_count",
    "differences_truncated",
    "sensitive_data_policy"
  ],
  "properties": {
    "report_schema_version": {
      "const": "1.0.0"
    },
    "operation": {
      "const": "READ_COMPARE"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": [
        "local",
        "test"
      ]
    },
    "outcome": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "operation_id": {
      "$ref": "#/$defs/identifier"
    },
    "fixture_id": {
      "$ref": "#/$defs/identifier"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "legacy_origin",
        "java_origin",
        "path_sha256",
        "request_headers_persisted"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "HEAD"
          ]
        },
        "legacy_origin": {
          "$ref": "#/$defs/loopbackOrigin"
        },
        "java_origin": {
          "$ref": "#/$defs/loopbackOrigin"
        },
        "path_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_headers_persisted": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "legacy_artifact_digest",
        "java_artifact_digest"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/identifier"
        },
        "legacy_artifact_digest": {
          "$ref": "#/$defs/artifactDigest"
        },
        "java_artifact_digest": {
          "$ref": "#/$defs/artifactDigest"
        }
      }
    },
    "environment_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy",
        "java"
      ],
      "properties": {
        "legacy": {
          "$ref": "#/$defs/fingerprintSummary"
        },
        "java": {
          "$ref": "#/$defs/fingerprintSummary"
        }
      }
    },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy",
        "java"
      ],
      "properties": {
        "legacy": {
          "$ref": "#/$defs/responseSummary"
        },
        "java": {
          "$ref": "#/$defs/responseSummary"
        }
      }
    },
    "raw_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_equal",
        "content_type_equal",
        "content_type_canonical_equal",
        "selected_headers_equal",
        "body_sha256_equal"
      ],
      "properties": {
        "status_equal": {
          "type": "boolean"
        },
        "content_type_equal": {
          "type": "boolean"
        },
        "content_type_canonical_equal": {
          "type": "boolean"
        },
        "selected_headers_equal": {
          "type": "boolean"
        },
        "body_sha256_equal": {
          "type": "boolean"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset_version",
        "ruleset_sha256",
        "operation_allowlisted",
        "legacy",
        "java"
      ],
      "properties": {
        "ruleset_version": {
          "$ref": "#/$defs/identifier"
        },
        "ruleset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operation_allowlisted": {
          "const": true
        },
        "legacy": {
          "$ref": "#/$defs/normalizationStats"
        },
        "java": {
          "$ref": "#/$defs/normalizationStats"
        }
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy",
        "java"
      ],
      "properties": {
        "legacy": {
          "$ref": "#/$defs/sideEffectSummary"
        },
        "java": {
          "$ref": "#/$defs/sideEffectSummary"
        }
      }
    },
    "differences": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/difference"
      }
    },
    "difference_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "differences_truncated": {
      "type": "boolean"
    },
    "sensitive_data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_request_headers_persisted",
        "raw_response_body_persisted",
        "difference_values_are_hashes",
        "sensitive_json_pointer_tokens_redacted",
        "report_scan_passed"
      ],
      "properties": {
        "raw_request_headers_persisted": {
          "const": false
        },
        "raw_response_body_persisted": {
          "const": false
        },
        "difference_values_are_hashes": {
          "const": true
        },
        "sensitive_json_pointer_tokens_redacted": {
          "const": true
        },
        "report_scan_passed": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pass"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "difference_count": {
            "const": 0
          },
          "differences": {
            "maxItems": 0
          },
          "differences_truncated": {
            "const": false
          },
          "side_effects": {
            "properties": {
              "legacy": {
                "properties": {
                  "changed": {
                    "const": false
                  }
                }
              },
              "java": {
                "properties": {
                  "changed": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "difference_count": {
            "minimum": 1
          },
          "differences": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "loopbackOrigin": {
      "type": "string",
      "pattern": "^http://(?:localhost|127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[1-9][0-9]{0,4}$"
    },
    "fingerprintSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_sha256",
        "redis_sha256",
        "volume_sha256"
      ],
      "properties": {
        "database_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "redis_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "volume_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "responseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "content_type",
        "canonical_content_type",
        "selected_headers",
        "body_sha256",
        "body_size",
        "duration_ms",
        "declared_json",
        "valid_json"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": "string",
          "maxLength": 512
        },
        "canonical_content_type": {
          "type": "string",
          "maxLength": 512
        },
        "selected_headers": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "cache-control",
              "content-encoding",
              "content-language",
              "etag",
              "last-modified",
              "vary",
              "x-content-type-options",
              "x-frame-options",
              "x-request-id"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          }
        },
        "body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "body_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "declared_json": {
          "type": "boolean"
        },
        "valid_json": {
          "type": "boolean"
        },
        "normalized_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_body_size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "normalizationStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ignored_declared",
        "ignored_applied",
        "unordered_declared",
        "unordered_applied",
        "headers_ignored_declared",
        "headers_ignored_applied"
      ],
      "properties": {
        "ignored_declared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "ignored_applied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "unordered_declared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "unordered_applied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "headers_ignored_declared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "headers_ignored_applied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sideEffectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditor",
        "source_kind",
        "before_sha256",
        "after_sha256",
        "changed"
      ],
      "properties": {
        "auditor": {
          "$ref": "#/$defs/identifier"
        },
        "source_kind": {
          "enum": [
            "file",
            "command"
          ]
        },
        "before_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "after_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "valueDescriptor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "missing"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sha256",
            "size"
          ],
          "properties": {
            "type": {
              "enum": [
                "null",
                "boolean",
                "number",
                "string",
                "array",
                "object"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "kind",
        "path",
        "legacy",
        "java"
      ],
      "properties": {
        "scope": {
          "enum": [
            "status",
            "content_type",
            "header",
            "body",
            "side_effect"
          ]
        },
        "kind": {
          "enum": [
            "value",
            "missing",
            "type",
            "array_order",
            "array_length",
            "invalid_json",
            "json_representation",
            "body_bytes"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 2048
        },
        "legacy": {
          "$ref": "#/$defs/valueDescriptor"
        },
        "java": {
          "$ref": "#/$defs/valueDescriptor"
        }
      }
    }
  }
}
