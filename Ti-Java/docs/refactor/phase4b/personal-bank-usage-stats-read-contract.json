  "time_semantics": {
    "injectable_clock": "java.time.Clock",
    "zone": "Asia/Shanghai",
    "comparison_model": "naive Beijing local datetime",
    "expired_when": "expires_at < now",
    "equal_to_now": "valid",
    "null_expiry": "valid",
    "empty_string_expiry": "valid",
    "zero_or_false_expiry": "valid",
    "truthy_malformed_expiry": "expired",
    "aware_vs_naive_comparison_error": "expired"
  },
  "usage_count_semantics": {
    "shared_sql_distinct_key": ["user_id", "expires_at"],
    "shared_set_key_after_expiry_filter": "user_id",
    "user_id_conversion": "int(value or 0); conversion failures ignored",
    "zero_user_id": "ignored",
    "negative_user_id": "counted",
    "owner_excluded_from_shared_users": true,
    "owner_excluded_from_public_users": true,
    "shared_and_public_categories_count_independently": true,
    "total_users": "owner plus shared/public set union",
    "total_users_excluding_owner": "nonzero total union excluding owner",
    "owner_count": 1
  },
  "failure_contract": {
    "bank_probe_failure": "propagate",
    "bank_missing_or_inactive": "return NOT_FOUND and execute no later query",
    "viewer_or_owner_invalid_or_mismatched": "return FORBIDDEN and execute no later query",
    "shared_query_failure": "independently degrade to empty set",
    "public_query_failure": "independently degrade to empty set",
    "both_optional_queries_fail": "AVAILABLE owner-only counts"
  },
  "persistence_contract": {
    "query_count": 3,
    "query_order": [
      "personal-bank-usage-stats-bank-probe",
      "personal-bank-usage-stats-shared-users",
      "personal-bank-usage-stats-public-users"
    ],
    "sequential_execution_required": true,
    "short_circuit_after_bank_probe": true,
    "optional_query_transaction_boundary": "REQUIRES_NEW read-only transaction per shared/public query",
    "join_or_query_collapse_authorized": false,
    "parallel_execution_authorized": false,
    "bank_id_jdbc_bind_type": "integer",
    "schema_or_index_delta": false,
    "queries": [
      {
        "query_id": "personal-bank-usage-stats-bank-probe",
        "adapter_field": "SELECT_BANK",
        "sql": "SELECT id,\n       user_id,\n       is_public,\n       status\nFROM user_question_banks\nWHERE id = :bank_id\n",
        "parameter_order": ["bank_id"],
        "parameters": {"bank_id": "integer"}
      },
      {
        "query_id": "personal-bank-usage-stats-shared-users",
        "adapter_field": "SELECT_SHARED_USERS",
        "sql": "SELECT DISTINCT bsr.user_id AS user_id,\n                bs.expires_at AS expires_at\nFROM bank_share_records bsr\nJOIN bank_shares bs ON bsr.share_id = bs.id\nWHERE bsr.bank_id = :bank_id\n  AND bsr.status = 1\n  AND bs.is_active = TRUE\n",
        "parameter_order": ["bank_id"],
        "parameters": {"bank_id": "integer"}
      },
      {
        "query_id": "personal-bank-usage-stats-public-users",
        "adapter_field": "SELECT_PUBLIC_USER_IDS",
        "sql": "SELECT DISTINCT user_id\nFROM public_bank_users\nWHERE bank_id = :bank_id\n",
        "parameter_order": ["bank_id"],
        "parameters": {"bank_id": "integer"}
      }
    ],
    "raw_nullable_projection_preserved": true,
    "business_table_writes": 0
  },
