    "legacy_owner_column_type": "integer",
    "sql": "SELECT bs.id,\n       bs.bank_id,\n       bs.owner_id,\n       bs.share_code,\n       bs.share_token,\n       bs.permission,\n       bs.expires_at,\n       bs.max_uses,\n       bs.current_uses,\n       bs.is_active,\n       bs.created_at,\n       b.name AS bank_name\nFROM bank_shares bs\nJOIN user_question_banks b ON bs.bank_id = b.id\nWHERE bs.owner_id = :viewer_id\n  AND b.status = 1\nORDER BY bs.created_at DESC NULLS FIRST\n",
