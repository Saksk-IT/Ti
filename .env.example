# ============================================================================
# Ti 项目 — 开发环境配置样例
# 复制为 .env 使用
# ============================================================================

FLASK_ENV=development

# 密钥（开发环境可用简单值）
SECRET_KEY=dev-secret-key-change-in-production

# 数据库（不设置则回退到 SQLite）
# DATABASE_URL=postgresql://studyuser:studypass@localhost:5432/ti_db

# SQLite 参数（仅未设置 DATABASE_URL 时生效）
SQLITE_TIMEOUT=15
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_JOURNAL_MODE=WAL

# 微信小程序
WECHAT_APPID=你的AppID
WECHAT_SECRET=你的AppSecret

# AI 解析（可选，不用可留空）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=你的DashScope密钥
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_TIMEOUT=25

# Redis（可选，不配则限流用内存、缓存降级）
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# 邮件（开发环境验证码输出到控制台，不发真实邮件）
MAIL_ENABLED=true
MAIL_CONSOLE_OUTPUT=true

# 短信验证码（开发环境输出到控制台，不发真实短信）
SMS_ENABLED=true
SMS_CONSOLE_OUTPUT=true
# 生产环境取消以下注释并填入真实值
# ALIYUN_ACCESS_KEY_ID=你的AccessKeyID
# ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
# 签名必须使用系统赠送签名：https://dypns.console.aliyun.com/smsCertParamsConfig/sign
# ALIYUN_SMS_SIGN_NAME=速通互联验证码
# 模板必须搭配赠送签名使用赠送模板：https://dypns.console.aliyun.com/smsCertParamsConfig/template
# ALIYUN_SMS_TEMPLATE_CODE=100001
# ALIYUN_SMS_TEMPLATE_CODE_BIND=100004
# ALIYUN_SMS_TEMPLATE_CODE_RESET=100003

# 响应压缩
ENABLE_GZIP=true
GZIP_MINIMUM_SIZE=500

# 缓存 TTL
QUIZ_API_CACHE_ENABLED=true
LAST_ACTIVE_UPDATE_INTERVAL_SECONDS=60
SSE_RETRY_AFTER_SECONDS=30

# 开发环境自动备份（北京时间）
BACKUP_TZ=Asia/Shanghai
BACKUP_ANCHOR_TIME=04:00
BACKUP_INTERVAL=43200
BACKUP_CHECK_INTERVAL=60
BACKUP_RETENTION_DAYS=3

# ============================================================================
# Ti 项目 — 生产环境配置样例
# 复制为 .env.production 或直接作为 .env 部署
# ============================================================================

# FLASK_ENV=production

# 密钥（必须用强随机字符串，否则启动报错）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=替换为强随机字符串

# 数据库（必须设置）
# DATABASE_URL=postgresql://用户名:密码@主机:5432/ti_db

# PostgreSQL 连接池
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=300

# 生产环境自动备份（北京时间，每天 04:00 / 16:00）
# BACKUP_TZ=Asia/Shanghai
# BACKUP_ANCHOR_TIME=04:00
# BACKUP_INTERVAL=43200
# BACKUP_CHECK_INTERVAL=60
# BACKUP_RETENTION_DAYS=7

# 微信小程序
# WECHAT_APPID=你的AppID
# WECHAT_SECRET=你的AppSecret

# AI 解析（可选）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=你的DashScope密钥
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_TIMEOUT=25

# Redis（必须配置，用于限流、缓存、任务队列）
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# RQ_QUEUE_NAME=saksk

# 邮件（必须配置真实 SMTP）
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=你的邮箱
# MAIL_PASSWORD=你的邮箱密码
# MAIL_DEFAULT_SENDER=noreply@example.com
# MAIL_DEFAULT_SENDER_NAME=系统通知
# MAIL_ENABLED=true
# MAIL_CONSOLE_OUTPUT=false

# 短信验证码（阿里云号码认证服务 DYPNS）
# RAM 用户需授权 dypns:SendSmsVerifyCode 和 dypns:CheckSmsVerifyCode
# ALIYUN_ACCESS_KEY_ID=你的AccessKeyID
# ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
# 签名必须使用系统赠送签名：https://dypns.console.aliyun.com/smsCertParamsConfig/sign
# ALIYUN_SMS_SIGN_NAME=速通互联验证码
# 模板必须搭配赠送签名使用赠送模板：https://dypns.console.aliyun.com/smsCertParamsConfig/template
# ALIYUN_SMS_TEMPLATE_CODE=100001
# ALIYUN_SMS_TEMPLATE_CODE_BIND=100004
# ALIYUN_SMS_TEMPLATE_CODE_RESET=100003
# ALIYUN_SMS_CODE_LENGTH=6
# ALIYUN_SMS_VALID_TIME=300
# ALIYUN_SMS_INTERVAL=60
# SMS_ENABLED=true
# SMS_CONSOLE_OUTPUT=false

# Nginx 反向代理（gunicorn 绑定 127.0.0.1 时启用）
# PROXY_FIX_ENABLED=true
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1

# HTTPS 强制重定向（推荐在 Nginx 层处理，Flask 层备用）
# FORCE_HTTPS=false

# Session Cookie 安全（HTTPS 环境下启用）
# SESSION_COOKIE_SECURE=true

# 响应压缩（Nginx 反代时可由 Nginx 接管）
# ENABLE_GZIP=true
# GZIP_MINIMUM_SIZE=500

# 额外允许的跨域来源（逗号分隔）
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# 缓存 TTL
# QUIZ_API_CACHE_ENABLED=true
# QUIZ_CACHE_TTL_QUESTION_DETAIL_SECONDS=300
# QUIZ_CACHE_TTL_COUNTS_SECONDS=60
# QUIZ_CACHE_TTL_SUBJECTS_SECONDS=60
# AI_EXPLAIN_CACHE_TTL_SECONDS=2592000
# JWT_USER_STATE_CACHE_TTL_SECONDS=20
# LAST_ACTIVE_UPDATE_INTERVAL_SECONDS=60
# SSE_RETRY_AFTER_SECONDS=30
