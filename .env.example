# ============================================================================
# Ti 项目 — 开发环境配置样例
# 复制为 .env 使用
# ============================================================================

FLASK_ENV=development

# 应用镜像（默认由开发者本地构建并推送到 GitHub Container Registry）
TI_IMAGE=ghcr.io/saksk-it/ti:latest
TI_IMAGE_PULL_POLICY=always

# 开发端口绑定
WEB_BIND=0.0.0.0
WEB_PORT=8000
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432

# 密钥（开发环境可用简单值）
SECRET_KEY=dev-secret-key-change-in-production

# 数据库（不设置则回退到 SQLite）
# DATABASE_URL=postgresql://studyuser:studypass@localhost:5432/ti_db

# SQLite 参数（仅未设置 DATABASE_URL 时生效）
SQLITE_TIMEOUT=15
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_JOURNAL_MODE=WAL

# 微信小程序
WECHAT_APPID=你的AppID
WECHAT_SECRET=你的AppSecret
WECHAT_MINICODE_ENV_VERSION=
WECHAT_MINICODE_CHECK_PATH=auto

# AI 解析（可选，不用可留空；后台系统设置会优先于环境变量）
AI_PROVIDER=dashscope
AI_API_TYPE=chat_completions
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_SOURCE=custom
AI_TIMEOUT=25
AI_CHANGE_RECORD_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=你的DashScope密钥
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_TIMEOUT=25

# Redis（可选，不配则限流用内存、缓存降级）
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# 邮件（开发环境验证码输出到控制台，不发真实邮件）
MAIL_ENABLED=true
MAIL_CONSOLE_OUTPUT=true

# 短信验证码（开发环境输出到控制台，不发真实短信）
SMS_ENABLED=true
SMS_CONSOLE_OUTPUT=true
# 生产环境取消以下注释并填入真实值
# ALIYUN_ACCESS_KEY_ID=你的AccessKeyID
# ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
# 签名必须使用系统赠送签名：https://dypns.console.aliyun.com/smsCertParamsConfig/sign
# ALIYUN_SMS_SIGN_NAME=速通互联验证码
# 模板必须搭配赠送签名使用赠送模板：https://dypns.console.aliyun.com/smsCertParamsConfig/template
# ALIYUN_SMS_TEMPLATE_CODE=100001
# ALIYUN_SMS_TEMPLATE_CODE_BIND=100004
# ALIYUN_SMS_TEMPLATE_CODE_RESET=100003

# 响应压缩
ENABLE_GZIP=true
GZIP_MINIMUM_SIZE=500

# 缓存 TTL
QUIZ_API_CACHE_ENABLED=true
LAST_ACTIVE_UPDATE_INTERVAL_SECONDS=60
SSE_RETRY_AFTER_SECONDS=30

# 数据库备份 sidecar 运行参数
# Cron、留存天数和 R2 凭据请在后台“系统设置 -> 数据库备份”配置。
# 此密钥仅用于加密后台保存的 R2 凭据；生产环境必须单独生成并离线保存。
BACKUP_CREDENTIAL_SECRET=dev-backup-credential-secret
TZ=Asia/Shanghai
BACKUP_SCHEDULER_POLL_SECONDS=60
BACKUP_JOB_LEASE_SECONDS=3600
BACKUP_PG_DUMP_TIMEOUT=900
BACKUP_STOP_GRACE_PERIOD=1h

# ============================================================================
# Ti 项目 — 生产环境配置样例
# 复制为 .env.production 或直接作为 .env 部署
# ============================================================================

# FLASK_ENV=production

# 生产镜像（服务器部署脚本只拉取该镜像，不在服务器构建）
# TI_IMAGE=ghcr.io/saksk-it/ti:latest
# TI_IMAGE_PULL_POLICY=always

# 生产默认先做到镜像运行并可用 IP 访问；域名与 HTTPS 后续单独配置。
# HTTP_BIND=0.0.0.0
# HTTP_PORT=8080
# SESSION_COOKIE_SECURE=false

# 邮件 / AI / 短信 / 微信小程序 现已支持在后台管理系统中配置：
# - /admin/settings/mail
# - /admin/settings/ai
# - /admin/settings/sms
# - /admin/settings/wechat-miniprogram
# 生产部署时可仅保留下面这些核心变量，其余可按需留空或完全省略。

# 密钥（必须用强随机字符串，否则启动报错）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=替换为强随机字符串

# 数据库（必须设置）
# DATABASE_URL=postgresql://用户名:密码@主机:5432/ti_db

# PostgreSQL 连接池
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=300

# 生产数据库备份 sidecar 运行参数
# Cron、留存天数、保留份数及 R2 配置均在后台管理，不放入环境文件。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
# BACKUP_CREDENTIAL_SECRET=替换为独立强随机字符串
# TZ=Asia/Shanghai
# BACKUP_SCHEDULER_POLL_SECONDS=60
# BACKUP_JOB_LEASE_SECONDS=3600
# BACKUP_PG_DUMP_TIMEOUT=900
# BACKUP_STOP_GRACE_PERIOD=1h

# 微信小程序
# WECHAT_APPID=你的AppID
# WECHAT_SECRET=你的AppSecret
# WECHAT_MINICODE_ENV_VERSION=
# WECHAT_MINICODE_CHECK_PATH=auto

# AI 解析（可选）
# AI_PROVIDER=openai
# AI_API_TYPE=responses
# AI_API_KEY=你的OpenAI或兼容上游密钥
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# AI_MODEL_SOURCE=custom
# AI_TIMEOUT=25
# OPENAI_API_KEY=你的OpenAI密钥
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=你的DashScope密钥
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_TIMEOUT=25

# Redis（必须配置，用于限流、缓存、任务队列）
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# RQ_QUEUE_NAME=saksk

# 邮件（必须配置真实 SMTP）
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=你的邮箱
# MAIL_PASSWORD=你的邮箱密码
# MAIL_DEFAULT_SENDER=noreply@example.com
# MAIL_DEFAULT_SENDER_NAME=系统通知
# MAIL_ENABLED=true
# MAIL_CONSOLE_OUTPUT=false

# 短信验证码（阿里云号码认证服务 DYPNS）
# RAM 用户需授权 dypns:SendSmsVerifyCode 和 dypns:CheckSmsVerifyCode
# ALIYUN_ACCESS_KEY_ID=你的AccessKeyID
# ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
# 签名必须使用系统赠送签名：https://dypns.console.aliyun.com/smsCertParamsConfig/sign
# ALIYUN_SMS_SIGN_NAME=速通互联验证码
# 模板必须搭配赠送签名使用赠送模板：https://dypns.console.aliyun.com/smsCertParamsConfig/template
# ALIYUN_SMS_TEMPLATE_CODE=100001
# ALIYUN_SMS_TEMPLATE_CODE_BIND=100004
# ALIYUN_SMS_TEMPLATE_CODE_RESET=100003
# ALIYUN_SMS_CODE_LENGTH=6
# ALIYUN_SMS_VALID_TIME=300
# ALIYUN_SMS_INTERVAL=60
# SMS_ENABLED=true
# SMS_CONSOLE_OUTPUT=false

# Nginx 反向代理（gunicorn 绑定 127.0.0.1 时启用）
# PROXY_FIX_ENABLED=true
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1

# HTTPS 强制重定向（推荐在 Nginx 层处理，Flask 层备用）
# FORCE_HTTPS=false

# Session Cookie 安全（HTTPS 后续配置启用后再改为 true）
# SESSION_COOKIE_SECURE=true

# 响应压缩（Nginx 反代时可由 Nginx 接管）
# ENABLE_GZIP=true
# GZIP_MINIMUM_SIZE=500

# 额外允许的跨域来源（逗号分隔）
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# 缓存 TTL
# QUIZ_API_CACHE_ENABLED=true
# QUIZ_CACHE_TTL_QUESTION_DETAIL_SECONDS=300
# QUIZ_CACHE_TTL_COUNTS_SECONDS=60
# QUIZ_CACHE_TTL_SUBJECTS_SECONDS=60
# AI_EXPLAIN_CACHE_TTL_SECONDS=2592000
# JWT_ACCESS_TOKEN_EXPIRES_SECONDS=1296000
# JWT_USER_STATE_CACHE_TTL_SECONDS=20
# LAST_ACTIVE_UPDATE_INTERVAL_SECONDS=60
# SSE_RETRY_AFTER_SECONDS=30
